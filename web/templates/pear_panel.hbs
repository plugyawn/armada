{{#if panel_open}}
<div class="pear-panel-inner">
    {{#if show_panel_header}}
    <div class="pear-panel-header {{#unless active_run_show_status}}pear-panel-header-idle{{/unless}} {{#if panel_header_quiet}}pear-panel-header-quiet{{/if}}">
        {{#if active_run_show_status}}
        <div class="pear-panel-title-row">
            <div class="pear-run-status-row pear-run-status-{{active_run.status_class}}{{#if active_run.is_active}} pear-liveness-active{{/if}}" aria-label="{{active_run.status_label}} {{active_run.status_marker}}" title="{{active_run.status_label}} {{active_run.status_marker}}">
                <span class="pear-panel-status-label">{{active_run.status_label}}</span>
                <span class="pear-ui-glyph pear-run-status-glyph {{#if active_run.is_active}}pear-thinking-glyph{{/if}}">{{active_run.status_marker}}</span>
            </div>
        </div>
        {{/if}}
        <div class="pear-panel-actions">
            {{#if has_panel_menu}}
            <details class="pear-run-actions pear-panel-run-actions" data-run-id="{{active_run.id}}">
                <summary class="pear-run-actions-summary pear-icon-button icon-button icon-button-square icon-button-neutral tippy-zulip-delayed-tooltip" aria-label="{{t 'Pear work menu' }}" data-tippy-content="{{t 'Pear work menu' }}">
                    <i class="zulip-icon zulip-icon-more-vertical" aria-hidden="true"></i>
                </summary>
                <div class="pear-run-actions-menu">
                    {{#if has_topic}}
                        <button type="button" id="pear-panel-refresh" class="pear-run-action-menu-item">
                            <i class="zulip-icon zulip-icon-reset" aria-hidden="true"></i>
                            <span>{{t "Refresh" }}</span>
                        </button>
                    {{/if}}
                    {{#if active_run.can_pause}}
                        <button type="button" class="pear-run-action pear-run-action-menu-item" data-action="pause" data-run-id="{{active_run.id}}">
                            <i class="zulip-icon zulip-icon-stop-circle" aria-hidden="true"></i>
                            <span>{{t "Pause" }}</span>
                        </button>
                    {{/if}}
                    {{#if active_run.can_resume}}
                        <button type="button" class="pear-run-action pear-run-action-menu-item" data-action="resume" data-run-id="{{active_run.id}}">
                            <i class="zulip-icon zulip-icon-play-circle" aria-hidden="true"></i>
                            <span>{{t "Resume" }}</span>
                        </button>
                    {{/if}}
                    {{#if active_run.can_cancel}}
                        <button type="button" class="pear-run-action pear-run-action-menu-item pear-run-action-danger" data-action="cancel" data-run-id="{{active_run.id}}">
                            <i class="zulip-icon zulip-icon-circle-x" aria-hidden="true"></i>
                            <span>{{t "Cancel" }}</span>
                        </button>
                    {{/if}}
                </div>
            </details>
            {{/if}}
        </div>
    </div>
    {{/if}}

    {{#if show_topic_control}}
    <section class="pear-topic-control" aria-label="{{t 'Pear context' }}">
        <div class="pear-topic-control-heading">
            <div class="pear-topic-control-title">
                <span class="pear-topic-control-title-text">{{t "Context" }}</span>
            </div>
            {{#unless show_workbench}}
            <button type="button" class="pear-panel-open-action pear-topic-open-action pear-icon-button icon-button icon-button-square icon-button-neutral tippy-zulip-delayed-tooltip" aria-label="{{t 'Open Pear work details' }}" data-tippy-content="{{t 'Open Pear work details' }}">
                <span class="pear-ui-glyph" aria-hidden="true">✶</span>
            </button>
            {{/unless}}
        </div>
        <div class="pear-topic-control-row">
            {{#if show_runtime_trigger}}
            <button type="button" class="pear-runtime-menu-trigger pear-runtime-panel-trigger pear-topic-runtime-trigger tippy-zulip-delayed-tooltip" aria-label="{{t 'Pear runtime' }}" data-tippy-content="{{t 'Pear runtime' }}">
                <span class="pear-ui-glyph pear-runtime-menu-glyph" aria-hidden="true">·</span>
                <span class="pear-topic-runtime-name">{{t "Model" }}</span>
                <span class="pear-runtime-menu-label">{{#if topic_context}}{{topic_context.panel_runtime_label}}{{/if}}</span>
            </button>
            {{/if}}
        </div>
        {{#if topic_context}}
            <button type="button" class="pear-panel-open-action pear-topic-context-row" aria-label="{{t 'Open Pear workspace details' }}">
                <span class="pear-topic-context-label">{{t "Repo" }}</span>
                <span class="pear-topic-context-main" title="{{topic_context.panel_repo_label}}">{{topic_context.panel_repo_label}}</span>
                {{#if topic_context.panel_git_status_label}}
                    <span class="pear-topic-context-status pear-topic-context-status-{{topic_context.panel_git_status_class}}">{{topic_context.panel_git_status_label}}</span>
                {{/if}}
            </button>
            <button type="button" class="pear-panel-open-action pear-topic-context-row pear-topic-context-row-secondary" aria-label="{{t 'Open Pear worktree details' }}">
                <span class="pear-topic-context-label">{{t "Worktree" }}</span>
                <span class="pear-topic-context-main" title="{{topic_context.panel_worktree_label}}">{{topic_context.panel_worktree_label}}</span>
                {{#if topic_context.panel_git_ref_label}}
                    <span class="pear-topic-context-ref" title="{{topic_context.panel_git_ref_label}}">{{topic_context.panel_git_ref_label}}</span>
                {{/if}}
            </button>
        {{else if has_topic}}
            <button type="button" class="pear-panel-open-action pear-topic-context-row pear-topic-context-row-secondary" aria-label="{{t 'Open Pear work details' }}">
                <span class="pear-topic-context-label">{{t "Topic" }}</span>
                <span class="pear-topic-context-main" title="{{context_label}}">{{context_label}}</span>
            </button>
        {{else}}
            <div class="pear-topic-context-row pear-topic-context-row-secondary" aria-label="{{t 'Pear channel context' }}">
                <span class="pear-topic-context-label">{{t "Channel" }}</span>
                <span class="pear-topic-context-main" title="{{context_label}}">{{context_label}}</span>
            </div>
            <div class="pear-topic-context-row pear-topic-context-row-secondary" aria-label="{{t 'Pear topic context' }}">
                <span class="pear-topic-context-label">{{t "Worktree" }}</span>
                <span class="pear-topic-context-main">{{t "Select a topic" }}</span>
            </div>
        {{/if}}
    </section>
    {{/if}}

    {{#if show_workbench}}
    {{#if has_topic}}
        {{#if topic_context}}
            <section class="pear-context-section">
                <div class="pear-workbench">
                    <div class="pear-workbench-header">
                        <div class="pear-workbench-title-row">
                            <span class="pear-ui-glyph pear-workbench-title-glyph" aria-hidden="true">·</span>
                            <span class="pear-workbench-title" title="{{topic_context.workbench_title}}">{{topic_context.workbench_title}}</span>
                            {{#if topic_context.workbench_meta}}
                                <span class="pear-workbench-meta" title="{{topic_context.workbench_meta}}">{{topic_context.workbench_meta}}</span>
                            {{/if}}
                            {{#if panel_can_close}}
                                <button type="button" class="pear-panel-close-action pear-workbench-close pear-icon-button icon-button icon-button-square icon-button-neutral tippy-zulip-delayed-tooltip" aria-label="{{t 'Hide Pear work details' }}" data-tippy-content="{{t 'Hide Pear work details' }}">
                                    <i class="zulip-icon zulip-icon-close" aria-hidden="true"></i>
                                </button>
                            {{/if}}
                        </div>
                        <div class="pear-workbench-context-row">
                            <div class="pear-workbench-tabs" aria-label="{{t 'Pear work views' }}">
                                <button type="button" class="pear-workbench-tab {{#if topic_context.workbench_diff_selected}}pear-workbench-tab-selected{{/if}}" data-pear-workbench-view="diff" {{#if topic_context.workbench_diff_disabled}}disabled{{/if}}>
                                    {{topic_context.diff_tab_label}}
                                </button>
                                <button type="button" class="pear-workbench-tab {{#if topic_context.workbench_history_selected}}pear-workbench-tab-selected{{/if}}" data-pear-workbench-view="history" {{#if topic_context.workbench_history_disabled}}disabled{{/if}}>
                                    {{topic_context.history_tab_label}}
                                </button>
                                <button type="button" class="pear-workbench-tab {{#if topic_context.workbench_canvas_selected}}pear-workbench-tab-selected{{/if}}" data-pear-workbench-view="canvas">
                                    {{topic_context.canvas_tab_label}}
                                </button>
                                <button type="button" class="pear-workbench-tab {{#if topic_context.workbench_side_selected}}pear-workbench-tab-selected{{/if}}" data-pear-workbench-view="side">
                                    {{topic_context.side_tab_label}}
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="pear-workbench-body pear-workbench-view-{{topic_context.workbench_view}}">
                        {{#if topic_context.workbench_diff_selected}}
                            {{#if topic_context.has_workbench_diff}}
                                {{#unless topic_context.has_changed_files}}
                                {{#if topic_context.has_workbench_diff_summary}}
                                    <div class="pear-workbench-summary" aria-label="{{topic_context.workbench_diff_summary_label}}">
                                        {{#if topic_context.workbench_diff_file_label}}
                                            <span class="pear-workbench-summary-chip pear-workbench-summary-files">{{topic_context.workbench_diff_file_label}}</span>
                                        {{/if}}
                                        {{#if topic_context.workbench_diff_insertions_label}}
                                            <span class="pear-workbench-summary-chip pear-workbench-summary-added">{{topic_context.workbench_diff_insertions_label}}</span>
                                        {{/if}}
                                        {{#if topic_context.workbench_diff_deletions_label}}
                                            <span class="pear-workbench-summary-chip pear-workbench-summary-deleted">{{topic_context.workbench_diff_deletions_label}}</span>
                                        {{/if}}
                                    </div>
                                {{/if}}
                                {{/unless}}
                                {{#if topic_context.has_changed_files}}
                                    <div class="pear-file-list">
                                        {{#each topic_context.git.changed_files}}
                                            <div class="pear-file-row pear-file-{{kind}}">
                                                <span class="pear-file-status">{{status}}</span>
                                                <span class="pear-file-path" title="{{path}}">{{path}}</span>
                                            </div>
                                        {{/each}}
                                        {{#if topic_context.git.changed_files_truncated}}
                                            <div class="pear-file-more">{{t "More changed files not shown." }}</div>
                                        {{/if}}
                                    </div>
                                {{/if}}
                            {{else}}
                                <div class="pear-workbench-empty">
                                    <span class="pear-ui-glyph pear-workbench-empty-glyph" aria-hidden="true">·</span>
                                    <span>{{t "No local diff." }}</span>
                                </div>
                            {{/if}}
                        {{/if}}
                        {{#if topic_context.workbench_history_selected}}
                            {{#if topic_context.git_tree_loading}}
                                <div class="pear-workbench-empty pear-liveness-active">
                                    <span class="pear-ui-glyph pear-workbench-empty-glyph pear-thinking-glyph" aria-hidden="true">·</span>
                                    <span>{{t "Loading Git history." }}</span>
                                </div>
                            {{else if topic_context.git_tree_error}}
                                <div class="pear-workbench-empty pear-workbench-empty-blocked">
                                    <span class="pear-ui-glyph pear-workbench-empty-glyph" aria-hidden="true">✷</span>
                                    <span>{{topic_context.git_tree_error}}</span>
                                </div>
                            {{else if topic_context.has_git_tree_graph}}
                                <div class="pear-git-tree">
                                    <pre class="pear-git-tree-graph">{{topic_context.git_tree.graph}}</pre>
                                    {{#if topic_context.has_git_tree_status}}
                                        <div class="pear-git-tree-block">
                                            <div class="pear-git-tree-label">{{t "Status" }}</div>
                                            <pre class="pear-git-tree-status">{{topic_context.git_tree.status_short}}</pre>
                                        </div>
                                    {{/if}}
                                </div>
                            {{else}}
                                {{#if topic_context.has_recent_commits}}
                                    <div class="pear-commit-list">
                                        {{#each topic_context.history_commits}}
                                            <div class="pear-commit-row {{#if is_head}}pear-commit-row-head{{/if}}">
                                                <span class="pear-commit-summary" title="{{summary}}">{{summary}}</span>
                                                <span class="pear-commit-hash">{{hash}}</span>
                                                {{#if ref_label}}
                                                    <span class="pear-commit-ref">{{ref_label}}</span>
                                                {{/if}}
                                            </div>
                                        {{/each}}
                                    </div>
                                {{else}}
                                    <div class="pear-workbench-empty">
                                        <span class="pear-ui-glyph pear-workbench-empty-glyph" aria-hidden="true">·</span>
                                        <span>{{t "No Git history." }}</span>
                                    </div>
                                {{/if}}
                            {{/if}}
                        {{/if}}
                        {{#if topic_context.workbench_canvas_selected}}
                            {{#if topic_context.canvas_loading}}
                                <div class="pear-workbench-empty pear-liveness-active">
                                    <span class="pear-ui-glyph pear-workbench-empty-glyph pear-thinking-glyph" aria-hidden="true">·</span>
                                    <span>{{t "Loading canvas." }}</span>
                                </div>
                            {{else if topic_context.canvas_error}}
                                <div class="pear-workbench-empty pear-workbench-empty-blocked">
                                    <span class="pear-ui-glyph pear-workbench-empty-glyph" aria-hidden="true">✷</span>
                                    <span>{{topic_context.canvas_error}}</span>
                                </div>
                            {{else if topic_context.canvas}}
                                <div class="pear-workbench-canvas">
                                    <div class="pear-workbench-canvas-toolbar">
                                        <span class="pear-workbench-canvas-path" title="{{topic_context.canvas_title}}">{{topic_context.canvas_title}}</span>
                                        <button type="button" class="pear-workbench-canvas-open tippy-zulip-delayed-tooltip" aria-label="{{t 'Edit canvas' }}" data-tippy-content="{{t 'Edit canvas' }}">{{t "edit" }}</button>
                                    </div>
                                    {{#if topic_context.canvas_has_content}}
                                        {{#if topic_context.canvas_has_rendered_html}}
                                            <div class="pear-workbench-canvas-rendered rendered_markdown">{{{topic_context.canvas_rendered_html}}}</div>
                                        {{else if topic_context.canvas_rendering}}
                                            <div class="pear-workbench-empty pear-liveness-active">
                                                <span class="pear-ui-glyph pear-workbench-empty-glyph pear-thinking-glyph" aria-hidden="true">·</span>
                                                <span>{{t "Rendering canvas." }}</span>
                                            </div>
                                        {{else}}
                                            <pre class="pear-workbench-canvas-source">{{topic_context.canvas.content}}</pre>
                                        {{/if}}
                                    {{else}}
                                        <div class="pear-workbench-empty">
                                            <span class="pear-ui-glyph pear-workbench-empty-glyph" aria-hidden="true">·</span>
                                            <span>{{t "Canvas is empty." }}</span>
                                        </div>
                                    {{/if}}
                                </div>
                            {{else}}
                                <div class="pear-workbench-empty pear-liveness-active">
                                    <span class="pear-ui-glyph pear-workbench-empty-glyph pear-thinking-glyph" aria-hidden="true">·</span>
                                    <span>{{t "Loading canvas." }}</span>
                                </div>
                            {{/if}}
                        {{/if}}
                        {{#if topic_context.workbench_side_selected}}
                            <div class="pear-side-body">
                                <div class="pear-side-header">
                                    <span class="pear-ui-glyph pear-side-header-glyph" aria-hidden="true">✧</span>
                                    <span>{{t "Private whisper" }}</span>
                                </div>
                                <textarea id="pear-side-request" class="pear-side-request" rows="2" placeholder="{{t 'Whisper to Pear' }}"></textarea>
                                <button type="button" id="pear-side-start" class="pear-side-start tippy-zulip-delayed-tooltip" aria-label="{{t 'Start private whisper' }}" data-tippy-content="{{t 'Start private whisper' }}" {{#unless has_topic}}disabled{{/unless}}>
                                    <span class="pear-ui-glyph" aria-hidden="true">✧</span>
                                </button>
                            </div>
                        {{/if}}
                    </div>
                </div>
            </section>
        {{else}}
            <div class="pear-empty-state pear-liveness-active">
                <span class="pear-ui-glyph pear-empty-state-glyph pear-thinking-glyph" aria-hidden="true">·</span>
                <span>{{t "Pear context is loading." }}</span>
            </div>
        {{/if}}
    {{else}}
        <div class="pear-empty-state">
            <span class="pear-ui-glyph pear-empty-state-glyph" aria-hidden="true">·</span>
            <span>{{t "Open a topic to see Pear context." }}</span>
        </div>
    {{/if}}
    {{/if}}

    {{#if error}}
        <div class="pear-panel-error">
            <span class="pear-ui-glyph pear-panel-error-glyph" aria-hidden="true">✷</span>
            <span>{{error}}</span>
        </div>
    {{/if}}

</div>
{{/if}}
