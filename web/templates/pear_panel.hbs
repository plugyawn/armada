{{#if panel_open}}
<div class="pear-panel-inner">
    <div class="pear-panel-header">
        <div class="pear-panel-title-row">
            <span class="pear-panel-title">{{t "Work" }}</span>
            {{#if active_run}}
                <div class="pear-run-status-row pear-run-status-{{active_run.status_class}}{{#if active_run.is_active}} pear-liveness-active{{/if}}">
                    <span class="pear-ui-glyph pear-run-status-glyph {{#if active_run.is_active}}pear-thinking-glyph{{/if}}" aria-hidden="true">{{active_run.status_marker}}</span>
                    <span class="pear-run-status-text">{{active_run.status_label}}</span>
                </div>
            {{/if}}
        </div>
        <div class="pear-panel-actions">
            {{#if panel_can_close}}
                <button type="button" id="pear-panel-close" class="pear-icon-button icon-button icon-button-square icon-button-neutral tippy-zulip-delayed-tooltip" aria-label="{{t 'Hide Pear work' }}" data-tippy-content="{{t 'Hide Pear work' }}">
                    <i class="zulip-icon zulip-icon-close" aria-hidden="true"></i>
                </button>
            {{/if}}
            {{#if active_run.has_actions}}
                <details class="pear-run-actions pear-panel-run-actions" data-run-id="{{active_run.id}}">
                    <summary class="pear-run-actions-summary pear-icon-button icon-button icon-button-square icon-button-neutral tippy-zulip-delayed-tooltip" aria-label="{{t 'Pear run actions' }}" data-tippy-content="{{t 'Pear run actions' }}">
                        <i class="zulip-icon zulip-icon-more-vertical" aria-hidden="true"></i>
                    </summary>
                    <div class="pear-run-actions-menu">
                    {{#if active_run.can_pause}}
                        <button type="button" class="pear-run-action pear-run-action-menu-item" data-action="pause" data-run-id="{{active_run.id}}">
                            <i class="zulip-icon zulip-icon-stop-circle" aria-hidden="true"></i>
                            <span>{{t "Pause" }}</span>
                        </button>
                    {{/if}}
                    {{#if active_run.can_resume}}
                        <button type="button" class="pear-run-action pear-run-action-menu-item" data-action="resume" data-run-id="{{active_run.id}}">
                            <i class="zulip-icon zulip-icon-play-circle" aria-hidden="true"></i>
                            <span>{{t "Resume" }}</span>
                        </button>
                    {{/if}}
                    {{#if active_run.can_cancel}}
                        <button type="button" class="pear-run-action pear-run-action-menu-item pear-run-action-danger" data-action="cancel" data-run-id="{{active_run.id}}">
                            <i class="zulip-icon zulip-icon-circle-x" aria-hidden="true"></i>
                            <span>{{t "Cancel" }}</span>
                        </button>
                    {{/if}}
                    </div>
                </details>
            {{/if}}
            <button type="button" id="pear-panel-refresh" class="pear-icon-button icon-button icon-button-square icon-button-neutral tippy-zulip-delayed-tooltip" aria-label="{{t 'Refresh Pear context' }}" data-tippy-content="{{t 'Refresh Pear context' }}">
                <i class="zulip-icon zulip-icon-reset" aria-hidden="true"></i>
            </button>
        </div>
    </div>

    {{#if has_topic}}
        {{#if topic_context}}
            <section class="pear-context-section">
                <div class="pear-workbench">
                    <div class="pear-workbench-header">
                        <div class="pear-workbench-title">
                            <span class="pear-workbench-title-main" title="{{topic_context.workbench_title_attr}}">{{topic_context.workbench_title}}</span>
                            {{#if topic_context.workbench_meta_label}}
                                <span class="pear-workbench-title-meta">{{topic_context.workbench_meta_label}}</span>
                            {{/if}}
                        </div>
                        <div class="pear-workbench-tabs" aria-label="{{t 'Pear work views' }}">
                            <button type="button" class="pear-workbench-tab {{#if topic_context.workbench_diff_selected}}pear-workbench-tab-selected{{/if}}" data-pear-workbench-view="diff" {{#if topic_context.workbench_diff_disabled}}disabled{{/if}}>
                                {{topic_context.diff_tab_label}}
                            </button>
                            <button type="button" class="pear-workbench-tab {{#if topic_context.workbench_history_selected}}pear-workbench-tab-selected{{/if}}" data-pear-workbench-view="history" {{#if topic_context.workbench_history_disabled}}disabled{{/if}}>
                                {{topic_context.history_tab_label}}
                            </button>
                            <button type="button" class="pear-workbench-tab {{#if topic_context.workbench_side_selected}}pear-workbench-tab-selected{{/if}}" data-pear-workbench-view="side">
                                {{topic_context.side_tab_label}}
                            </button>
                        </div>
                    </div>
                    <div class="pear-workbench-body pear-workbench-view-{{topic_context.workbench_view}}">
                        {{#if topic_context.workbench_diff_selected}}
                            {{#if topic_context.has_workbench_diff}}
                                {{#if topic_context.git.diff_shortstat}}
                                    <div class="pear-workbench-summary">
                                        <span class="pear-workbench-summary-chip">{{topic_context.git.diff_shortstat}}</span>
                                    </div>
                                {{/if}}
                                {{#if topic_context.has_changed_files}}
                                    <div class="pear-file-list">
                                        {{#each topic_context.git.changed_files}}
                                            <div class="pear-file-row pear-file-{{kind}}">
                                                <span class="pear-file-status">{{status}}</span>
                                                <span class="pear-file-path" title="{{path}}">{{path}}</span>
                                            </div>
                                        {{/each}}
                                        {{#if topic_context.git.changed_files_truncated}}
                                            <div class="pear-file-more">{{t "More changed files not shown." }}</div>
                                        {{/if}}
                                    </div>
                                {{/if}}
                            {{else}}
                                <div class="pear-workbench-empty">{{t "No local diff." }}</div>
                            {{/if}}
                        {{/if}}
                        {{#if topic_context.workbench_history_selected}}
                            {{#if topic_context.has_recent_commits}}
                                <div class="pear-commit-list">
                                    {{#each topic_context.git.recent_commits}}
                                        <div class="pear-commit-row">
                                            <span class="pear-ui-glyph pear-commit-marker" aria-hidden="true">✦</span>
                                            <span class="pear-commit-summary" title="{{summary}}">{{summary}}</span>
                                            <span class="pear-commit-hash">{{hash}}</span>
                                        </div>
                                    {{/each}}
                                </div>
                            {{else}}
                                <div class="pear-workbench-empty">{{t "No recent commits." }}</div>
                            {{/if}}
                        {{/if}}
                        {{#if topic_context.workbench_side_selected}}
                            <div class="pear-side-body">
                                <textarea id="pear-side-request" class="pear-side-request" rows="2" placeholder="{{t 'Private side request' }}"></textarea>
                                <button type="button" id="pear-side-start" class="pear-side-start tippy-zulip-delayed-tooltip" aria-label="{{t 'Start private side request' }}" data-tippy-content="{{t 'Start private side request' }}" {{#unless has_topic}}disabled{{/unless}}>
                                    <span class="pear-ui-glyph" aria-hidden="true">✧</span>
                                </button>
                            </div>
                        {{/if}}
                    </div>
                </div>
            </section>
        {{else}}
            <div class="pear-empty-state">{{t "Pear context is loading." }}</div>
        {{/if}}
    {{else}}
        <div class="pear-empty-state">{{t "Open a topic to see Pear context." }}</div>
    {{/if}}

    {{#if error}}
        <div class="pear-panel-error">{{error}}</div>
    {{/if}}

</div>
{{/if}}
