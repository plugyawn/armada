{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:armada:contract:widget-v1",
  "title": "Armada plugin widget document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "blocks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "data": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "anyOf": [
          {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/listItem"
            }
          },
          {
            "oneOf": [
              {
                "$ref": "#/$defs/scalar"
              },
              {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "$ref": "#/$defs/scalar"
                }
              }
            ]
          }
        ]
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/widgetAction"
      }
    },
    "rest": {
      "$ref": "#/$defs/rest"
    }
  },
  "$defs": {
    "scalar": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "prompt"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "neutral",
        "running",
        "success",
        "warning",
        "error",
        "selected",
        "muted"
      ]
    },
    "copyBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "body"
      ],
      "properties": {
        "type": {
          "const": "copy"
        },
        "eyebrow": {
          "type": "string",
          "maxLength": 80
        },
        "heading": {
          "type": "string",
          "maxLength": 160
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "metricBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label",
        "value"
      ],
      "properties": {
        "type": {
          "const": "metric"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "value": {
          "$ref": "#/$defs/scalar"
        },
        "bind": {
          "type": "string",
          "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
        },
        "unit": {
          "type": "string",
          "maxLength": 24
        },
        "delta": {
          "type": "number"
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "meterBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label",
        "value"
      ],
      "properties": {
        "type": {
          "const": "meter"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "value": {
          "type": "number"
        },
        "bind": {
          "type": "string",
          "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
        },
        "total": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "maxLength": 24
        },
        "detail": {
          "type": "string",
          "maxLength": 160
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "seriesBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label",
        "values"
      ],
      "properties": {
        "type": {
          "const": "series"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "values": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "number"
          }
        },
        "bind": {
          "type": "string",
          "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
        },
        "unit": {
          "type": "string",
          "maxLength": 24
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "logBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label",
        "lines"
      ],
      "properties": {
        "type": {
          "const": "log"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "lines": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "bind": {
          "type": "string",
          "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "keyValueBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label",
        "items"
      ],
      "properties": {
        "type": {
          "const": "key_value"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "items": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "type": "string",
                "maxLength": 80
              },
              "value": {
                "$ref": "#/$defs/scalar"
              }
            }
          }
        }
      }
    },
    "sceneBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label",
        "root"
      ],
      "properties": {
        "type": {
          "const": "scene"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "aspect": {
          "type": "string",
          "enum": [
            "wide",
            "standard",
            "square",
            "tall"
          ]
        },
        "root": {
          "$ref": "#/$defs/node"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/sceneStep"
          }
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/copyBlock"
        },
        {
          "$ref": "#/$defs/metricBlock"
        },
        {
          "$ref": "#/$defs/meterBlock"
        },
        {
          "$ref": "#/$defs/seriesBlock"
        },
        {
          "$ref": "#/$defs/logBlock"
        },
        {
          "$ref": "#/$defs/keyValueBlock"
        },
        {
          "$ref": "#/$defs/sceneBlock"
        },
        {
          "$ref": "#/$defs/listBlock"
        }
      ]
    },
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "derive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "add",
            "subtract",
            "multiply",
            "divide",
            "min",
            "max",
            "clamp",
            "equal",
            "greater",
            "less",
            "and",
            "or",
            "not"
          ]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/scalar"
              },
              {
                "type": "string",
                "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
              }
            ]
          }
        }
      }
    },
    "sceneStepChange": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "sceneStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "changes"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/sceneStepChange"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "x-armada-type-properties": {
        "group": [
          "type",
          "id",
          "state",
          "layout",
          "columns",
          "align",
          "children",
          "repeat",
          "transition",
          "interaction",
          "ariaLabel"
        ],
        "text": [
          "type",
          "id",
          "state",
          "text",
          "textRole",
          "bind",
          "derive",
          "repeat",
          "transition",
          "interaction",
          "ariaLabel"
        ],
        "shape": [
          "type",
          "id",
          "state",
          "shape",
          "label",
          "repeat",
          "transition",
          "interaction",
          "ariaLabel"
        ],
        "connector": [
          "type",
          "id",
          "state",
          "from",
          "to",
          "directed",
          "label"
        ],
        "path": [
          "type",
          "id",
          "state",
          "points",
          "closed",
          "repeat",
          "transition",
          "interaction",
          "ariaLabel"
        ],
        "symbol": [
          "type",
          "id",
          "state",
          "symbol",
          "repeat",
          "transition",
          "interaction",
          "ariaLabel"
        ],
        "mark": [
          "type",
          "id",
          "state",
          "mark",
          "values",
          "bind",
          "repeat",
          "transition",
          "interaction",
          "ariaLabel"
        ],
        "control": [
          "type",
          "id",
          "state",
          "control",
          "action",
          "value",
          "min",
          "max",
          "step",
          "label",
          "repeat",
          "transition",
          "ariaLabel"
        ]
      },
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "group",
            "text",
            "shape",
            "connector",
            "path",
            "symbol",
            "mark",
            "control"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "layout": {
          "type": "string",
          "enum": [
            "row",
            "column",
            "grid",
            "graph",
            "overlay"
          ]
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "stretch",
            "between"
          ]
        },
        "children": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "textRole": {
          "type": "string",
          "enum": [
            "title",
            "label",
            "body",
            "value",
            "note",
            "mono"
          ]
        },
        "bind": {
          "type": "string",
          "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
        },
        "derive": {
          "$ref": "#/$defs/derive"
        },
        "shape": {
          "type": "string",
          "enum": [
            "rectangle",
            "circle",
            "ellipse",
            "line",
            "pill",
            "diamond"
          ]
        },
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
        },
        "directed": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "maxLength": 160
        },
        "points": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "closed": {
          "type": "boolean"
        },
        "symbol": {
          "type": "string",
          "enum": [
            "arrow",
            "check",
            "warning",
            "error",
            "play",
            "pause",
            "clock",
            "file",
            "folder",
            "code",
            "person",
            "agent"
          ]
        },
        "mark": {
          "type": "string",
          "enum": [
            "bar",
            "line",
            "point",
            "area",
            "arc"
          ]
        },
        "values": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "number"
          }
        },
        "control": {
          "type": "string",
          "enum": [
            "button",
            "toggle",
            "range",
            "stepper"
          ]
        },
        "action": {
          "type": "string",
          "maxLength": 80
        },
        "value": {
          "$ref": "#/$defs/scalar"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        },
        "transition": {
          "type": "string",
          "enum": [
            "none",
            "value",
            "position",
            "enter_exit"
          ]
        },
        "interaction": {
          "type": "string",
          "enum": [
            "none",
            "select",
            "toggle",
            "filter",
            "step"
          ]
        },
        "ariaLabel": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "glyph": {
      "type": "string",
      "enum": [
        "search",
        "home",
        "repo",
        "repo-open",
        "hash",
        "lock",
        "plus",
        "nav",
        "branch",
        "commit",
        "pr",
        "more",
        "panel",
        "clip",
        "send",
        "steer",
        "answer",
        "queue",
        "stop",
        "down",
        "react",
        "thread",
        "copy",
        "link",
        "edit",
        "retry",
        "open",
        "latest",
        "folder",
        "folder-open",
        "file",
        "doc",
        "image",
        "table",
        "chart",
        "term",
        "diff",
        "minus",
        "check",
        "x",
        "expand",
        "right",
        "trace",
        "eye",
        "globe",
        "person",
        "settings",
        "sound",
        "mute",
        "gpu",
        "plugin"
      ]
    },
    "runState": {
      "type": "string",
      "enum": [
        "done",
        "live",
        "waiting",
        "needs",
        "failed",
        "paused",
        "stopped"
      ]
    },
    "httpUrl": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https?://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:[/?#][^\\s<>\"'`\\\\]*)?$"
    },
    "linkAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "url": {
          "$ref": "#/$defs/httpUrl"
        }
      }
    },
    "binding": {
      "type": "string",
      "pattern": "^data\\.[A-Za-z0-9_-]{1,80}$"
    },
    "rest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figure",
        "sizer"
      ],
      "properties": {
        "figure": {
          "$ref": "#/$defs/binding"
        },
        "news": {
          "$ref": "#/$defs/binding"
        },
        "sizer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        }
      }
    },
    "toolAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "tool"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "tool": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "arguments": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/scalar"
              },
              {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "$ref": "#/$defs/scalar"
                }
              }
            ]
          }
        },
        "confirm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "spark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 120,
          "items": {
            "type": "number"
          }
        },
        "domain": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "code": {
          "type": "boolean"
        },
        "sub": {
          "type": "string",
          "maxLength": 120
        },
        "state": {
          "$ref": "#/$defs/runState"
        },
        "glyph": {
          "$ref": "#/$defs/glyph"
        },
        "spark": {
          "$ref": "#/$defs/spark"
        },
        "facets": {
          "type": "object",
          "maxProperties": 4,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "figure": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 24
            },
            {
              "type": "number"
            }
          ]
        },
        "open": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "$ref": "#/$defs/httpUrl"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "widget"
              ],
              "properties": {
                "widget": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,31}$"
                }
              }
            }
          ]
        },
        "action": {
          "$ref": "#/$defs/widgetAction"
        }
      }
    },
    "listBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "const": "list"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "caption": {
          "type": "string",
          "maxLength": 24
        },
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "items": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/listItem"
          }
        },
        "bind": {
          "$ref": "#/$defs/binding"
        }
      }
    },
    "widgetAction": {
      "oneOf": [
        {
          "$ref": "#/$defs/action"
        },
        {
          "$ref": "#/$defs/toolAction"
        },
        {
          "$ref": "#/$defs/linkAction"
        }
      ]
    }
  }
}
