#!/usr/bin/env python3
"""Report whether the live Pear worker state is plausibly stuck."""

from __future__ import annotations

import argparse
import json
import os
import sys
from dataclasses import asdict, dataclass
from datetime import timedelta
from pathlib import Path
from typing import Any

BASE_DIR = Path(__file__).resolve().parents[1]


@dataclass(frozen=True)
class PearHealthReport:
    active_run_count: int
    stale_active_run_count: int
    stale_run_age_seconds: int
    active_run_samples: list[dict[str, Any]]
    stale_active_run_samples: list[dict[str, Any]]


def maybe_reexec_with_checkout_venv() -> None:
    venv_dir = BASE_DIR / ".venv"
    venv_python = venv_dir / "bin" / "python3"
    if not venv_python.exists() or Path(sys.prefix).resolve() == venv_dir.resolve():
        return
    env = os.environ.copy()
    env.pop("PYTHONHOME", None)
    env.pop("PYTHONPATH", None)
    env["VIRTUAL_ENV"] = str(venv_dir)
    env["PATH"] = f"{venv_dir / 'bin'}:{env.get('PATH', '')}"
    os.execve(str(venv_python), [str(venv_python), *sys.argv], env)


def setup_django() -> tuple[Any, Any, int, Any]:
    sys.path.append(str(BASE_DIR))
    from scripts.lib.setup_path import setup_path

    setup_path()
    os.environ.setdefault("DJANGO_SETTINGS_MODULE", "zproject.settings")
    import django

    django.setup()
    from django.db.models import Q
    from django.utils.timezone import now as timezone_now

    from zerver.lib.pear_worker import pear_worker_stale_after_seconds
    from zerver.models.bots import PearWorkerRun

    return PearWorkerRun, Q, pear_worker_stale_after_seconds(), timezone_now


def run_sample(run: Any) -> dict[str, Any]:
    return {
        "id": run.id,
        "status": run.status,
        "stream": run.stream_name,
        "topic": run.topic_name,
        "result_message_id": run.result_message_id,
        "date_updated": run.date_updated.isoformat(),
        "heartbeat_at": run.heartbeat_at.isoformat() if run.heartbeat_at else None,
    }


def collect_health(*, stale_run_age_seconds: int | None, sample_limit: int) -> PearHealthReport:
    PearWorkerRun, Q, default_stale_age, timezone_now = setup_django()
    stale_age = stale_run_age_seconds or default_stale_age
    active_runs = PearWorkerRun.objects.filter(status__in=["queued", "running"]).order_by(
        "-date_updated", "-id"
    )
    cutoff = timezone_now() - timedelta(seconds=stale_age)
    stale_runs = active_runs.filter(
        Q(status="queued", date_updated__lte=cutoff)
        | Q(status="running", heartbeat_at__lte=cutoff)
        | Q(status="running", heartbeat_at__isnull=True, date_updated__lte=cutoff)
    )
    return PearHealthReport(
        active_run_count=active_runs.count(),
        stale_active_run_count=stale_runs.count(),
        stale_run_age_seconds=stale_age,
        active_run_samples=[run_sample(run) for run in active_runs[:sample_limit]],
        stale_active_run_samples=[run_sample(run) for run in stale_runs[:sample_limit]],
    )


def render_report(report: PearHealthReport) -> str:
    lines = [
        "Pear live health:",
        f"active_runs={report.active_run_count}",
        f"stale_active_runs={report.stale_active_run_count}",
        f"stale_run_age_seconds={report.stale_run_age_seconds}",
    ]
    for label, samples in (
        ("active_run_samples", report.active_run_samples),
        ("stale_active_run_samples", report.stale_active_run_samples),
    ):
        if samples:
            lines.append(f"{label}:")
            lines.extend(f"- {sample}" for sample in samples)
    return "\n".join(lines)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Report live Pear worker health.")
    active_run_limit = parser.add_mutually_exclusive_group()
    active_run_limit.add_argument("--max-active-runs", type=int, default=0)
    active_run_limit.add_argument(
        "--allow-active-runs",
        action="store_true",
        help="Report active runs without treating fresh work as unhealthy.",
    )
    parser.add_argument("--max-stale-active-runs", type=int, default=0)
    parser.add_argument("--stale-run-age-seconds", type=int)
    parser.add_argument("--sample-limit", type=int, default=5)
    parser.add_argument("--json", action="store_true")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if min(args.max_active_runs, args.max_stale_active_runs, args.sample_limit) < 0:
        raise SystemExit("run limits must be non-negative")
    if args.stale_run_age_seconds is not None and args.stale_run_age_seconds <= 0:
        raise SystemExit("--stale-run-age-seconds must be positive")
    maybe_reexec_with_checkout_venv()
    report = collect_health(
        stale_run_age_seconds=args.stale_run_age_seconds,
        sample_limit=args.sample_limit,
    )
    print(
        json.dumps(asdict(report), indent=2, sort_keys=True) if args.json else render_report(report)
    )
    violations = []
    if not args.allow_active_runs and report.active_run_count > args.max_active_runs:
        violations.append(
            f"active_run_count={report.active_run_count} exceeds {args.max_active_runs}"
        )
    if report.stale_active_run_count > args.max_stale_active_runs:
        violations.append(
            "stale_active_run_count="
            f"{report.stale_active_run_count} exceeds {args.max_stale_active_runs}"
        )
    if violations:
        print("Pear health check failed:", file=sys.stderr)
        for violation in violations:
            print(f"- {violation}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
