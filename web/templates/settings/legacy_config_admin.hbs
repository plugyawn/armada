<div id="admin-pear-config" class="settings-subsection-parent">
    <div class="settings-section-title">{{t "Pear pair-programming" }}</div>
    <div id="pear-config-status" class="alert-notification"></div>
    <div class="input-group">
        <label>{{t "Status" }}</label>
        <div id="pear-config-readiness">{{t "Loading…" }}</div>
        <ul id="pear-config-setup-steps" class="settings-choice-description"></ul>
        <div id="pear-config-runtime-login" class="settings-choice-description"></div>
    </div>
    <div class="input-group">
        <label for="select-pear-bot">{{t "Selected Pear bot" }}</label>
        <select id="select-pear-bot" class="setting-widget prop-element" disabled>
            <option value="">{{t "No Pear bot configured" }}</option>
        </select>
    </div>
    <div class="input-group">
        {{> ../components/action_button
          id="provision-pear-bot"
          label=(t "Provision Pear bot")
          variant="solid"
          intent="brand"
          }}
        {{> ../components/action_button
          id="save-pear-bot-selection"
          label=(t "Save selected bot")
          variant="subtle"
          intent="brand"
          disabled=true
          }}
    </div>
</div>
