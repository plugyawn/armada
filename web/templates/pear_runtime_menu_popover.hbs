<div class="popover-menu" id="pear-runtime-menu-popover" aria-labelledby="pear-runtime-menu" data-simplebar data-simplebar-tab-index="-1">
    <ul role="menu" class="popover-menu-list">
        {{#if has_runtime}}
        <li role="none" class="link-item">
            <div class="pear-runtime-summary" role="menuitem">
                <span class="pear-ui-glyph pear-runtime-summary-glyph" aria-hidden="true">✦</span>
                <span class="pear-runtime-summary-main">{{runtime_label}}</span>
                <span class="pear-runtime-summary-sub">{{t "model" }}</span>
            </div>
        </li>
        <li role="separator" class="popover-menu-separator"></li>
        <li role="none" class="link-item">
            <a role="menuitem" class="pear-canvas-menu-link popover-menu-link" tabindex="0">
                <span class="pear-ui-glyph pear-runtime-action-glyph" aria-hidden="true">✧</span>
                <span class="popover-menu-label">{{t 'Canvas' }}</span>
            </a>
        </li>
        <li role="none" class="link-item">
            <a role="menuitem" class="pear-files-menu-link popover-menu-link" tabindex="0">
                <span class="pear-ui-glyph pear-runtime-action-glyph" aria-hidden="true">✩</span>
                <span class="popover-menu-label">{{t 'Files' }}</span>
            </a>
        </li>
        <li role="separator" class="popover-menu-separator"></li>
        <li role="none" class="link-item">
            <label class="pear-runtime-group-header popover-menu-link" role="menuitem">
                <span class="popover-menu-label">{{t 'Model' }}</span>
            </label>
        </li>
        {{#each model_choices}}
        <li role="none" class="link-item">
            <label class="popover-menu-link" role="menuitemradio" tabindex="0">
                <input type="radio" class="pear-runtime-model-choice" name="pear-runtime-model" value="{{value}}" {{#if selected}}checked{{/if}} tabindex="-1"/>
                <span class="popover-menu-label">{{label}}</span>
            </label>
        </li>
        {{/each}}
        <li role="separator" class="popover-menu-separator"></li>
        <li role="none" class="link-item">
            <label class="pear-runtime-group-header popover-menu-link" role="menuitem">
                <span class="popover-menu-label">{{t 'Reasoning effort' }}</span>
            </label>
        </li>
        {{#each effort_choices}}
        <li role="none" class="link-item">
            <label class="popover-menu-link" role="menuitemradio" tabindex="0">
                <input type="radio" class="pear-runtime-effort-choice" name="pear-runtime-effort" value="{{value}}" {{#if selected}}checked{{/if}} tabindex="-1"/>
                <span class="popover-menu-label">{{label}}</span>
            </label>
        </li>
        {{/each}}
        {{else}}
        <li role="none" class="link-item">
            <label class="pear-runtime-group-header popover-menu-link" role="menuitem">
                <span class="popover-menu-label">{{status_message}}</span>
            </label>
        </li>
        {{/if}}
    </ul>
</div>
