[Unit]
Description=Pear Codex worker slot 0
After=network-online.target pear-zulip-dev.service
Wants=pear-zulip-dev.service

[Service]
Type=simple
User=zulipdev
WorkingDirectory=/home/zulipdev/zulip
EnvironmentFile=/home/zulipdev/pear.env
ExecStart=/bin/bash -lc 'cd /home/zulipdev/zulip && exec /home/zulipdev/zulip/.venv/bin/python3 /home/zulipdev/zulip/manage.py process_queue --queue_name pear_worker --worker_num 0 --automated'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
