#!/usr/bin/env python3
"""Fail if a commit of the fork added a line that holds a credential.

The repository is public.  Armada's builders hold real credentials (a
DigitalOcean token, Codex and GitHub sign-ins), so every line any commit
of the fork added, not only what is left at the head, is read for the
shapes those credentials take.  The patterns are the issuers' documented
prefixes, so a match is very rarely anything else; Zulip's own test
fixtures predate the fork and are not read.

    tools/armada/ci/secrets-scan            every commit since the fork base
    tools/armada/ci/secrets-scan A..B       the commits in a range

A finding prints the commit, the file and the kind of credential, never
the line itself.  A credential that reached a commit must be revoked at
its issuer: rewriting history does not take it back from a public clone.
"""

import re
import subprocess
import sys
from collections.abc import Iterable, Iterator
from typing import NamedTuple

FORK_BASE = "7813218321"

CREDENTIALS = {
    "private key": r"-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY(?: BLOCK)?-----",
    "GitHub token": r"\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{60,})",
    "OpenAI key": r"\bsk-(?:proj|svcacct|admin)-[A-Za-z0-9_-]{40,}|\bsk-[A-Za-z0-9]{20}T3BlbkFJ",
    "Anthropic key": r"\bsk-ant-[a-z]+\d*-[A-Za-z0-9_-]{40,}",
    "DigitalOcean token": r"\bdo[opr]_v1_[a-f0-9]{64}\b",
    "AWS access key": r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b",
    "Slack token": r"\bxox[abposr]-[A-Za-z0-9-]{10,}",
    "Stripe live key": r"\b[rs]k_live_[A-Za-z0-9]{20,}",
    "Google API key": r"\bAIza[0-9A-Za-z_-]{35}\b",
}
CREDENTIAL = re.compile(
    "|".join(f"(?P<g{i}>{pattern})" for i, pattern in enumerate(CREDENTIALS.values()))
)
KINDS = list(CREDENTIALS)


class Finding(NamedTuple):
    commit: str
    path: str
    kind: str


def credential_kind(line: str) -> str | None:
    match = CREDENTIAL.search(line)
    if match is None:
        return None
    assert match.lastgroup is not None
    return KINDS[int(match.lastgroup.removeprefix("g"))]


def scan_patch(lines: Iterable[str]) -> Iterator[Finding]:
    """Read `git log -p --format=commit:%H` output; yield each added credential."""
    commit = path = ""
    in_hunk = False
    for line in lines:
        if line.startswith(("commit:", "diff --git ")):
            in_hunk = False
            if line.startswith("commit:"):
                commit = line.removeprefix("commit:").strip()
        elif not in_hunk:
            if line.startswith("+++ "):
                path = line.removeprefix("+++ ").strip().removeprefix("b/")
            in_hunk = line.startswith("@@")
        elif line.startswith("+") and (kind := credential_kind(line)) is not None:
            yield Finding(commit, path, kind)


def main() -> None:
    revisions = sys.argv[1] if len(sys.argv) > 1 else f"{FORK_BASE}..HEAD"
    log = subprocess.Popen(
        [
            "git",
            "log",
            "-p",
            "-U0",
            "--no-merges",
            "--no-ext-diff",
            "--format=commit:%H",
            revisions,
        ],
        stdout=subprocess.PIPE,
        text=True,
        errors="replace",
    )
    assert log.stdout is not None
    findings = list(scan_patch(log.stdout))
    if log.wait() != 0:
        sys.exit("secrets-scan: git log failed")
    for finding in findings:
        print(f"{finding.commit[:10]} {finding.path}: a {finding.kind} was added", file=sys.stderr)
    if findings:
        sys.exit(
            f"secrets-scan: {len(findings)} credential(s) in {revisions}; revoke each at its issuer"
        )
    print(f"secrets-scan: no credential added in {revisions}")


if __name__ == "__main__":
    main()
