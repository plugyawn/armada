{{! The topic-level "Pear is working…" liveness row, rendered into
    #typing_notifications while a Pear run is streaming. Styled by
    .pear-typing-notification in web/styles/pear.css; the server-side
    typing emit that drives this is a separate slice. }}
<li class="typing_notification pear-typing-notification">
    <span class="pear-typing-dots" aria-hidden="true"><span></span><span></span><span></span></span>
    {{t "Pear is working…" }}
</li>
