<span
  class="legacy-topic-header-status no-select"
  data-legacy-header-key="{{control_key}}"
  >
    <span class="legacy-topic-header-runtime-group">
        <button
          type="button"
          class="legacy-topic-header-control legacy-topic-header-runtime-control legacy-runtime-menu-trigger"
          data-legacy-header-key="{{control_key}}"
          >
            <span
              class="legacy-ui-glyph legacy-runtime-menu-glyph"
              aria-hidden="true"
              >·</span>
            <span class="legacy-runtime-menu-model-label"></span>
            <span
              class="legacy-topic-header-runtime-separator"
              aria-hidden="true"
              >·</span>
            <span class="legacy-runtime-menu-effort-label"></span>
            <i
              class="zulip-icon zulip-icon-chevron-down legacy-topic-header-control-chevron"
              aria-hidden="true"
              ></i>
        </button>
    </span>
    <span class="legacy-topic-header-commitline">
        <span
          class="legacy-topic-header-control legacy-topic-header-branch-control tippy-zulip-delayed-tooltip"
          data-legacy-header-key="{{control_key}}"
          >
            <i
              class="zulip-icon zulip-icon-git-branch legacy-topic-header-git-icon"
              aria-hidden="true"
              ></i>
            <span class="legacy-topic-header-branch-label"></span>
        </span>
        <button
          type="button"
          class="legacy-topic-header-control legacy-topic-header-git-control legacy-panel-open-action"
          data-legacy-header-key="{{control_key}}"
          >
            <i
              class="zulip-icon zulip-icon-git-commit legacy-topic-header-git-icon"
              aria-hidden="true"
              ></i>
            <span class="legacy-commitline-sha"></span>
            <span class="legacy-commitline-subject"></span>
            <span class="legacy-commitline-meta"></span>
        </button>
    </span>
    <span
      class="legacy-workspace-tabs legacy-workspace-tabs-hidden"
      role="tablist"
      aria-label="{{t 'Topic view'}}"
      >
        <button
          type="button"
          class="legacy-workspace-mode-tab legacy-workspace-tab-selected"
          data-legacy-tab="chat"
          role="tab"
          aria-controls="message_feed_container"
          >{{t "Chat"}}</button>
        <button
          type="button"
          class="legacy-workspace-mode-tab"
          data-legacy-tab="readme"
          role="tab"
          aria-controls="legacy-workspace-pane"
          >{{t "README"}}</button>
        <button
          type="button"
          class="legacy-workspace-mode-tab"
          data-legacy-tab="files"
          role="tab"
          aria-controls="legacy-workspace-pane"
          >{{t "Files"}}</button>
    </span>
</span>
