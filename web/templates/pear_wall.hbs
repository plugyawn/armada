<div class="pear-wall-header">
    <input class="pear-wall-input" type="text" autocomplete="off" maxlength="500" placeholder="{{t 'watch something…' }}" aria-label="{{t 'Create a wall monitor' }}" />
</div>
{{#if has_blocks}}
<div class="pear-wall-blocks">
    {{#each blocks}}
    <section class="pear-wall-block pear-wall-status-{{status}} {{#if collapsed}}pear-wall-collapsed{{/if}}" data-monitor-id="{{id}}">
        <header class="pear-wall-block-header">
            <button type="button" class="pear-wall-collapse" data-wall-action="collapse" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}">{{#if collapsed}}▸{{else}}▾{{/if}}</button>
            <span class="pear-wall-title" title="{{ask}}">{{title}}</span>
            <span class="pear-wall-dot" aria-hidden="true"></span>
        </header>
        {{#unless collapsed}}
        <div class="pear-wall-body pear-wall-kit">
            {{#if is_provisioning}}
            <div class="pear-wall-provisioning">
                <span class="pear-thinking-glyph-animated"></span>
                <span>{{t "setting up…" }}</span>
            </div>
            {{else if is_error}}
            <div class="pear-wall-error">
                <span class="pear-wall-error-text" title="{{last_error}}">{{last_error_short}}</span>
                <button type="button" class="pear-wall-foot-action" data-wall-action="rebuild">⟳ {{t "rebuild" }}</button>
            </div>
            {{else}}
            {{> pear_wall_components . }}
            {{/if}}
        </div>
        <footer class="pear-wall-block-footer">
            {{#if show_cadence}}
            <button type="button" class="pear-wall-foot-action" data-wall-action="cadence" data-tippy-content="{{t 'Change cadence' }}">{{t "every" }} {{cadence_label}}</button>
            {{/if}}
            {{#if is_live}}
            <button type="button" class="pear-wall-foot-action" data-wall-action="refresh" data-tippy-content="{{t 'Refresh now' }}">⟳</button>
            <button type="button" class="pear-wall-foot-action" data-wall-action="pause" data-tippy-content="{{t 'Pause' }}">⏸</button>
            {{/if}}
            {{#if is_paused}}
            <button type="button" class="pear-wall-foot-action" data-wall-action="resume" data-tippy-content="{{t 'Resume' }}">▶</button>
            {{/if}}
            <span class="pear-wall-foot-spacer"></span>
            <button type="button" class="pear-wall-foot-action pear-wall-delete" data-wall-action="delete" data-tippy-content="{{t 'Remove' }}">✕</button>
        </footer>
        {{/unless}}
    </section>
    {{/each}}
</div>
{{else}}
<div class="pear-wall-empty">{{t "type above — pear keeps it live here" }}</div>
{{/if}}
