<section
  class="legacy-workspace-shell"
  aria-label="{{t 'Workspace' }}"
  data-room="files"
  data-readme-state="unknown"
  >
    <header class="legacy-workspace-shell__header">
        <button
          type="button"
          data-action="toggle-explorer"
          class="legacy-workspace-shell__explorer-toggle legacy-workspace-icon-button"
          aria-controls="legacy-workspace-explorer"
          aria-expanded="false"
          aria-label="{{t 'Toggle file explorer' }}"
          >
            <i class="zulip-icon zulip-icon-panel-left" aria-hidden="true"></i>
            <span class="legacy-workspace-shell__button-label">Files</span>
        </button>
        <div class="legacy-workspace-shell__identity">
            <strong data-role="workspace-title">Files</strong>
            <span data-role="workspace-meta"></span>
        </div>
        <button
          type="button"
          data-action="refresh"
          class="legacy-workspace-icon-button"
          aria-label="{{t 'Refresh workspace' }}"
          >
            <i class="zulip-icon zulip-icon-refresh-cw" aria-hidden="true"></i>
        </button>
    </header>
    <div class="legacy-workspace-shell__body">
        <aside
          id="legacy-workspace-explorer"
          class="legacy-workspace-shell__explorer"
          aria-label="{{t 'Workspace explorer' }}"
          >
            <form data-role="search-form" role="search">
                <input
                  data-role="search-input"
                  type="search"
                  autocomplete="off"
                  aria-label="{{t 'Search files' }}"
                  placeholder="{{t 'Filter files' }}"
                  />
            </form>
            <div
              data-role="search-results"
              role="listbox"
              aria-label="{{t 'Workspace search results' }}"
              hidden
              >
            </div>
            <div
              class="legacy-workspace-shell__tree"
              data-role="tree"
              role="tree"
              aria-label="{{t 'Workspace files' }}"
              >
            </div>
        </aside>
        <div
          class="legacy-workspace-shell__splitter"
          data-role="explorer-splitter"
          role="separator"
          aria-label="{{t 'Resize file explorer' }}"
          aria-orientation="vertical"
          aria-valuemin="180"
          aria-valuemax="480"
          tabindex="0"
          >
        </div>
        <main
          id="legacy-workspace-document-panel"
          class="legacy-workspace-shell__document"
          aria-label="{{t 'Workspace document' }}"
          role="tabpanel"
          tabindex="-1"
          >
            <div data-role="tabs" role="tablist" aria-label="{{t 'Open files' }}"></div>
            <header class="legacy-workspace-shell__document-header">
                <nav data-role="breadcrumb" aria-label="{{t 'File path' }}"></nav>
                <div class="legacy-workspace-shell__document-actions">
                    <span
                      id="legacy-workspace-mode-feedback"
                      class="legacy-workspace-shell__mode-feedback"
                      data-role="mode-feedback"
                      role="status"
                      aria-live="polite"
                      aria-atomic="true"
                      hidden
                      >
                    </span>
                    <div class="legacy-workspace-file-menu-wrap">
                        <button
                          type="button"
                          data-role="file-menu-button"
                          aria-haspopup="menu"
                          aria-expanded="false"
                          >File<i class="zulip-icon zulip-icon-chevron-down" aria-hidden="true"></i></button>
                        <div
                          data-role="file-menu"
                          class="legacy-workspace-file-menu"
                          role="menu"
                          aria-label="{{t 'File actions' }}"
                          hidden
                          >
                            <button
                              type="button"
                              role="menuitem"
                              data-file-action="create-file"
                              >New file</button>
                            <button
                              type="button"
                              role="menuitem"
                              data-file-action="create-folder"
                              >New folder</button>
                            <button
                              type="button"
                              role="menuitem"
                              data-file-action="create-readme"
                              hidden
                              >Create README</button>
                            <button
                              type="button"
                              role="menuitem"
                              data-file-action="rename"
                              >Rename / Move</button>
                            <button
                              type="button"
                              role="menuitem"
                              data-file-action="delete"
                              >Delete</button>
                            <button
                              type="button"
                              role="menuitem"
                              data-file-action="copy-path"
                              >Copy path</button>
                            <button
                              type="button"
                              role="menuitem"
                              data-file-action="reveal"
                              >Reveal in explorer</button>
                            <button
                              type="button"
                              role="menuitem"
                              data-file-action="history"
                              >History</button>
                        </div>
                    </div>
                    <button type="button" data-action="ask-armada" hidden>Ask Onix</button>
                    <div
                      class="legacy-workspace-segmented"
                      role="group"
                      aria-label="{{t 'Document view' }}"
                      >
                        <button
                          type="button"
                          data-action="mode-preview"
                          aria-pressed="false"
                          hidden
                          >Read</button>
                        <button
                          type="button"
                          data-action="mode-rich"
                          aria-describedby="legacy-workspace-mode-feedback"
                          >Rich</button>
                        <button
                          type="button"
                          data-action="mode-source"
                          aria-describedby="legacy-workspace-mode-feedback"
                          >Source</button>
                    </div>
                    <a
                      data-role="raw-link"
                      class="legacy-workspace-icon-button"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="{{t 'Open raw file' }}"
                      ><i class="zulip-icon zulip-icon-external-link" aria-hidden="true"></i></a>
                    <a
                      data-role="download-link"
                      class="legacy-workspace-icon-button"
                      aria-label="{{t 'Download file' }}"
                      ><i class="zulip-icon zulip-icon-download" aria-hidden="true"></i></a>
                </div>
            </header>
            <div data-role="conflict" role="alert" hidden>
                <span>This file changed outside the editor.</span>
                <details>
                    <summary>View disk version</summary>
                    <pre data-role="conflict-remote"></pre>
                </details>
                <button
                  type="button"
                  data-action="conflict-reload"
                  >Reload</button>
                <button
                  type="button"
                  data-action="conflict-overwrite"
                  >Overwrite</button>
            </div>
            <div
              class="legacy-workspace-readme-empty"
              data-role="readme-empty"
              hidden
              >
                <span
                  class="legacy-workspace-readme-empty__glyph"
                  aria-hidden="true"
                  >README</span>
                <strong>No README yet</strong>
                <span>Create the durable context layer for this topic.</span>
                <button type="button" data-action="create-readme">Create README</button>
            </div>
            <div class="legacy-workspace-shell__surface">
                <div
                  data-role="editor"
                  class="legacy-workspace-shell__editor"
                  >
                </div>
                <article
                  data-role="preview"
                  class="legacy-workspace-shell__preview"
                  aria-label="{{t 'Rendered Markdown' }}"
                  hidden
                  >
                </article>
                <div
                  data-role="nontext"
                  class="legacy-workspace-shell__nontext"
                  hidden
                  >
                </div>
            </div>
            <footer
              class="legacy-workspace-shell__status"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              >
                <span data-role="status">Loading workspace…</span>
                <span data-role="status-actions" hidden>
                    <button type="button" data-action="save-retry">Retry save</button>
                    <button type="button" data-action="discard-changes">Discard changes</button>
                </span>
            </footer>
        </main>
    </div>
    <div data-role="file-dialog-layer"></div>
</section>
