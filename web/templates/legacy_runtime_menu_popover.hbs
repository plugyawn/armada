<div class="popover-menu" id="legacy-runtime-menu-popover" aria-label="{{t 'Onix runtime' }}" data-simplebar data-simplebar-tab-index="-1">
    <ul role="menu" class="popover-menu-list">
        {{#if has_runtime}}
        <li role="none" class="link-item">
            <div class="legacy-runtime-menu-section text-item" role="none">{{t 'Model' }}</div>
        </li>
        {{#each model_choices}}
            <li role="none" class="link-item">
                <label class="legacy-runtime-menu-choice legacy-runtime-model-menu-choice popover-menu-link {{#if selected}}legacy-runtime-menu-choice-selected{{/if}}" role="menuitemradio" aria-checked="{{#if selected}}true{{else}}false{{/if}}" data-model="{{value}}" tabindex="0">
                    <input type="radio" class="legacy-runtime-model-choice" name="legacy-runtime-model" value="{{value}}" {{#if selected}}checked{{/if}}/>
                    <i class="legacy-runtime-choice-check zulip-icon zulip-icon-check" aria-hidden="true"></i>
                    <span class="popover-menu-label">{{label}}</span>
                </label>
            </li>
        {{/each}}
        <li role="separator" class="popover-menu-separator"></li>
        <li role="none" class="link-item">
            <div class="legacy-runtime-menu-section text-item" role="none">{{t 'Thinking' }}</div>
        </li>
        {{#each effort_choices}}
            <li role="none" class="link-item">
                <label class="legacy-runtime-menu-choice legacy-runtime-effort-menu-choice popover-menu-link {{#if selected}}legacy-runtime-menu-choice-selected{{/if}}" role="menuitemradio" aria-checked="{{#if selected}}true{{else}}false{{/if}}" data-effort="{{value}}" tabindex="0">
                    <input type="radio" class="legacy-runtime-effort-choice" name="legacy-runtime-effort" value="{{value}}" {{#if selected}}checked{{/if}}/>
                    <i class="legacy-runtime-choice-check zulip-icon zulip-icon-check" aria-hidden="true"></i>
                    <span class="popover-menu-label">{{label}}</span>
                </label>
            </li>
        {{/each}}
        <li role="separator" class="popover-menu-separator"></li>
        <li role="none" class="link-item">
            <div class="legacy-runtime-menu-section text-item" role="none">{{t 'Presence' }}</div>
        </li>
        {{#each presence_choices}}
            <li role="none" class="link-item">
                <label class="legacy-runtime-menu-choice legacy-runtime-presence-menu-choice popover-menu-link {{#if selected}}legacy-runtime-menu-choice-selected{{/if}}" role="menuitemradio" aria-checked="{{#if selected}}true{{else}}false{{/if}}" data-policy="{{value}}" tabindex="0">
                    <input type="radio" class="legacy-runtime-presence-choice" name="legacy-runtime-presence" value="{{value}}" {{#if selected}}checked{{/if}}/>
                    <i class="legacy-runtime-choice-check zulip-icon zulip-icon-check" aria-hidden="true"></i>
                    <span class="popover-menu-label">{{label}}</span>
                </label>
            </li>
        {{/each}}
        <li role="none" class="link-item">
            <div class="legacy-runtime-presence-note" role="note">{{t '@Onix always works' }}</div>
        </li>
        {{#if runtime_usage_meter.has_meter}}
        <li role="separator" class="popover-menu-separator"></li>
        <li role="none" class="link-item">
            <div class="legacy-runtime-meter-block {{#if runtime_usage_meter.is_hot}}legacy-runtime-meter-hot{{/if}}" role="none">
                <div class="legacy-runtime-meter-row">
                    <span>{{runtime_usage_meter.label}}</span>
                    <span>{{runtime_usage_meter.value}}</span>
                </div>
                <span class="legacy-runtime-meter-line" aria-hidden="true">
                    <span class="legacy-runtime-meter-fill"></span>
                </span>
            </div>
        </li>
        {{/if}}
        {{#if has_runtime_usage}}
        <li role="none" class="link-item">
            <div class="legacy-runtime-usage" role="none" {{#if runtime_usage_title}}title="{{runtime_usage_title}}"{{/if}}>
                {{#each runtime_usage_rows}}
                    <span class="legacy-runtime-usage-label">{{label}}</span>
                    <span class="legacy-runtime-usage-value">{{value}}</span>
                {{/each}}
            </div>
        </li>
        {{/if}}
        {{else}}
        <li role="none" class="link-item">
            <label class="legacy-runtime-group-header legacy-runtime-summary {{#if runtime_status.is_active}}legacy-liveness-active{{/if}} popover-menu-link" role="menuitem">
                <span class="legacy-ui-glyph legacy-runtime-summary-glyph {{runtime_status.class_name}} {{#if runtime_status.is_active}}legacy-thinking-glyph{{/if}}" aria-hidden="true">{{runtime_status.glyph}}</span>
                <span class="popover-menu-label">{{status_message}}</span>
            </label>
        </li>
        {{/if}}
    </ul>
</div>
