<span
    class="pear-topic-header-status no-select"
    data-pear-header-key="{{control_key}}"
>
    <span class="pear-topic-header-runtime-group">
        <button
            type="button"
            class="pear-topic-header-control pear-topic-header-runtime-control pear-runtime-menu-trigger"
            data-pear-header-key="{{control_key}}"
        >
            <span
                class="pear-ui-glyph pear-runtime-menu-glyph"
                aria-hidden="true"
            >·</span>
            <span class="pear-runtime-menu-model-label"></span>
            <span
                class="pear-topic-header-runtime-separator"
                aria-hidden="true"
            >·</span>
            <span class="pear-runtime-menu-effort-label"></span>
            <i
                class="zulip-icon zulip-icon-chevron-down pear-topic-header-control-chevron"
                aria-hidden="true"
            ></i>
        </button>
    </span>
    <span class="pear-topic-header-commitline">
        <span
            class="pear-topic-header-control pear-topic-header-branch-control tippy-zulip-delayed-tooltip"
            data-pear-header-key="{{control_key}}"
        >
            <i
                class="zulip-icon zulip-icon-git-branch pear-topic-header-git-icon"
                aria-hidden="true"
            ></i>
            <span class="pear-topic-header-branch-label"></span>
        </span>
        <button
            type="button"
            class="pear-topic-header-control pear-topic-header-git-control pear-panel-open-action"
            data-pear-header-key="{{control_key}}"
        >
            <i
                class="zulip-icon zulip-icon-git-commit pear-topic-header-git-icon"
                aria-hidden="true"
            ></i>
            <span class="pear-commitline-sha"></span>
            <span class="pear-commitline-subject"></span>
            <span class="pear-commitline-meta"></span>
        </button>
    </span>
    <span
        class="pear-workspace-tabs pear-workspace-tabs-hidden"
        role="tablist"
        aria-label="{{t 'Topic view'}}"
    >
        <button
            type="button"
            class="pear-workspace-mode-tab pear-workspace-tab-selected"
            data-pear-tab="chat"
            role="tab"
            aria-controls="message_feed_container"
        >{{t "Chat"}}</button>
        <button
            type="button"
            class="pear-workspace-mode-tab"
            data-pear-tab="workspace"
            role="tab"
            aria-controls="pear-workspace-pane"
        >{{t "Workspace"}}</button>
    </span>
</span>