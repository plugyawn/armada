#!/usr/bin/env python3
"""Run mypy over the project and fail if it finds more errors than allowed.

The trunk carried mypy errors from before the rebuild (446 on 15 October
2026) while they are being fixed.  This holds the count from rising: a
change that adds an error fails, and one that removes some is asked to
lower ALLOWED_ERRORS, like the fork ledger's counts.  At zero this
script is deleted and CI runs tools/run-mypy itself.
"""

import os
import re
import subprocess
import sys

ALLOWED_ERRORS = 446

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))
SUMMARY = re.compile(r"^Found (\d+) errors? in \d+ files?")


def main() -> None:
    result = subprocess.run(
        ["tools/run-mypy"], cwd=ROOT, capture_output=True, text=True, check=False
    )
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    if result.returncode == 0:
        errors = 0
    else:
        counts = [
            int(match[1]) for line in result.stdout.splitlines() if (match := SUMMARY.match(line))
        ]
        if not counts:
            sys.exit("mypy-ratchet: mypy failed without its summary line")
        errors = counts[-1]

    if errors > ALLOWED_ERRORS:
        sys.exit(
            f"mypy-ratchet: {errors} errors, more than the {ALLOWED_ERRORS} allowed; fix the new ones"
        )
    if errors < ALLOWED_ERRORS:
        print(
            f"::notice::mypy-ratchet: {errors} errors, fewer than the {ALLOWED_ERRORS} allowed;"
            f" lower ALLOWED_ERRORS in tools/armada/ci/mypy-ratchet to {errors}"
        )
    print(f"mypy-ratchet: {errors} errors, {ALLOWED_ERRORS} allowed")


if __name__ == "__main__":
    main()
