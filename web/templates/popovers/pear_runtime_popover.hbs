<div class="popover-menu pear-runtime-popover" data-simplebar data-simplebar-tab-index="-1">
    <ul role="menu" class="popover-menu-list">
        <li role="none" class="popover-menu-list-item">
            <div class="pear-runtime-popover-heading">{{t "Model" }}</div>
            <div role="group" class="tab-picker tab-picker-vertical" aria-label="{{t 'Model' }}">
                {{#each models}}
                <input type="radio" id="pear-model-{{@index}}" class="tab-option pear-runtime-popover-control" name="pear-model-select" data-model-slug="{{value}}" {{#if selected}}checked{{/if}} />
                <label role="menuitemradio" class="tab-option-content" for="pear-model-{{@index}}" tabindex="0">
                    <span class="popover-menu-label">{{label}}</span>
                </label>
                {{/each}}
            </div>
        </li>
        <li role="none" class="popover-menu-list-item">
            <div class="pear-runtime-popover-heading">{{t "Thinking" }}</div>
            <div role="group" class="pear-effort-segments" aria-label="{{t 'Thinking effort' }}">
                {{#each efforts}}
                <button type="button" role="radio" aria-checked="{{#if selected}}true{{else}}false{{/if}}" class="pear-effort-segment pear-runtime-popover-control{{#if selected}} selected{{/if}}" data-effort="{{effort}}" tabindex="0">{{label}}</button>
                {{/each}}
            </div>
        </li>
        {{#if active_runs}}
        <li role="none" class="popover-menu-list-item">
            <div class="pear-runtime-popover-heading">{{t "Runs" }}</div>
            {{#each active_runs}}
            <div class="pear-runtime-popover-run">
                <span class="pear-runtime-popover-run-summary">{{summary}}</span>
                {{#if is_paused}}
                <button type="button" class="pear-run-pause-toggle pear-runtime-popover-control" data-run-id="{{id}}" data-action="resume">{{t "Resume" }}</button>
                {{else}}
                <button type="button" class="pear-run-pause-toggle pear-runtime-popover-control" data-run-id="{{id}}" data-action="pause">{{t "Pause" }}</button>
                {{/if}}
            </div>
            {{/each}}
        </li>
        {{/if}}
        <li role="none" class="popover-menu-list-item">
            <div class="pear-runtime-popover-error hidden"></div>
        </li>
    </ul>
</div>
