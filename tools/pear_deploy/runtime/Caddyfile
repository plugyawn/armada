{$PEAR_CADDY_FQDN} {
	encode zstd gzip

	# The deployed Debian Caddy 2.6 runtime names this directive basicauth.
	basicauth {
		{$PEAR_CADDY_BASICAUTH_USER} {$PEAR_CADDY_BASICAUTH_HASH}
	}

	handle_path /static/webpack-bundles/* {
		root * /home/zulipdev/zulip/prod-static/serve/webpack-bundles
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server {
			precompressed gzip
		}
	}

	handle_path /static/* {
		root * /home/zulipdev/zulip/prod-static/serve
		header Cache-Control "no-cache"
		header X-Content-Type-Options "nosniff"
		file_server {
			precompressed gzip
		}
	}

	handle {
		# Replace the accepted outer credential with the optional inner Zulip
		# API credential before entering reverse_proxy. Keeping the copy and the
		# bridge-header deletion in separate handlers avoids Caddy's delete-first
		# request-header transformation ordering.
		request_header Authorization {http.request.header.X-Pear-Upstream-Authorization}
		reverse_proxy 127.0.0.1:9991 {
			# Authenticated deployment probes may carry a distinct Zulip API
			# credential in this private bridge header. Never forward the bridge
			# header itself after promoting its value to Authorization above.
			header_up -X-Pear-Upstream-Authorization
		}
	}
}
