{$PEAR_CADDY_FQDN} {
	encode zstd gzip

	# The deployed Debian Caddy 2.6 runtime names this directive basicauth.
	basicauth {
		{$PEAR_CADDY_BASICAUTH_USER} {$PEAR_CADDY_BASICAUTH_HASH}
	}

	handle_path /static/webpack-bundles/* {
		root * /home/zulipdev/zulip/prod-static/serve/webpack-bundles
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server {
			precompressed gzip
		}
	}

	handle_path /static/* {
		root * /home/zulipdev/zulip/prod-static/serve
		header Cache-Control "no-cache"
		header X-Content-Type-Options "nosniff"
		file_server {
			precompressed gzip
		}
	}

	handle {
		reverse_proxy 127.0.0.1:9991 {
			# The outer Basic Auth credential is only for Caddy. Forwarding it
			# makes Zulip's dual session/API upload routes reinterpret it as an
			# invalid API credential and reject otherwise authenticated images.
			header_up -Authorization
			# Authenticated deployment probes may carry a distinct Zulip API
			# credential in this private bridge header. Promote it only after the
			# outer basicauth handler has accepted the request, and never forward
			# the bridge header itself.
			header_up Authorization {http.request.header.X-Pear-Upstream-Authorization}
			header_up -X-Pear-Upstream-Authorization
		}
	}
}
