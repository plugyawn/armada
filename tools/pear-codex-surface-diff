#!/usr/bin/env python3
"""Diff the codex binary's app-server method surface against the baseline.

The codexification doctrine: Pear replicates Codex, so every Codex
upgrade should answer "what did the engine add?" in one command. This
extracts JSON-RPC-shaped method names from the binary's strings and
diffs them against tools/pear-codex-surface-baseline.txt.

Usage:
    tools/pear-codex-surface-diff --binary /path/to/codex [--write]

Run it wherever the real (vendored) codex binary lives; --write updates
the baseline after reviewing the additions.
"""

import argparse
import re
import sys
from pathlib import Path

METHOD_PREFIXES = (
    "thread",
    "turn",
    "item",
    "commandExecution",
    "fileChange",
    "model",
    "account",
    "review",
    "skills",
    "mcpServer",
    "fuzzyFileSearch",
    "collaborationMode",
    "agent",
    "realtime",
)
# A plausible wire method: known prefix, one or two clean camelCase
# segments. The strings table concatenates adjacent literals, so
# anything longer or oddly-cased is noise.
METHOD_PATTERN = re.compile(
    (
        "(?:" + "|".join(METHOD_PREFIXES) + ")"
        "(?:/[a-z][a-zA-Z]{1,30}){1,2}"
    ).encode()
)
BASELINE_PATH = Path(__file__).parent / "pear-codex-surface-baseline.txt"


def extract_methods(binary_path: Path) -> set[str]:
    blob = binary_path.read_bytes()
    return {match.group().decode() for match in METHOD_PATTERN.finditer(blob)}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binary", required=True, type=Path)
    parser.add_argument("--write", action="store_true", help="update the baseline")
    args = parser.parse_args()

    methods = extract_methods(args.binary)
    baseline = (
        set(BASELINE_PATH.read_text().split()) if BASELINE_PATH.exists() else set()
    )
    added = sorted(methods - baseline)
    removed = sorted(baseline - methods)
    for method in added:
        print(f"+ {method}")
    for method in removed:
        print(f"- {method}")
    if not added and not removed:
        print("surface unchanged")
    if args.write:
        BASELINE_PATH.write_text("\n".join(sorted(methods)) + "\n")
        print(f"baseline updated ({len(methods)} methods)")
    return 1 if (added or removed) and not args.write else 0


if __name__ == "__main__":
    sys.exit(main())
