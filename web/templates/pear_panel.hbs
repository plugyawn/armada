<div class="pear-panel-inner">
    <div class="pear-panel-header">
        <div class="pear-panel-title-row">
            <span class="pear-panel-title">{{t "Context" }}</span>
        </div>
        <div class="pear-panel-actions">
            <button type="button" id="pear-panel-refresh" class="pear-icon-button icon-button icon-button-square icon-button-neutral tippy-zulip-delayed-tooltip" aria-label="{{t 'Refresh Pear context' }}" data-tippy-content="{{t 'Refresh Pear context' }}">
                <i class="zulip-icon zulip-icon-reset" aria-hidden="true"></i>
            </button>
        </div>
    </div>

    {{#if has_topic}}
        {{#if topic_context}}
            <section class="pear-context-section pear-runtime-section">
                <div class="pear-context-section-title">{{t "Runtime" }}</div>
                <div class="pear-runtime-row">
                    <label class="pear-field-label" for="pear-topic-model-select">{{t "Model" }}</label>
                    <select id="pear-topic-model-select" class="pear-topic-model-select pear-topic-runtime-control">
                        {{#each topic_context.display_model_choices}}
                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="pear-runtime-row pear-effort-row">
                    <div class="pear-effort-header">
                        <label class="pear-field-label" for="pear-reasoning-effort-slider">{{t "Thinking" }}</label>
                        <span id="pear-reasoning-effort-value" class="pear-effort-value">{{topic_context.effort_label}}</span>
                    </div>
                    <input id="pear-reasoning-effort-slider" class="pear-reasoning-effort-slider pear-topic-runtime-control" type="range" min="0" max="{{topic_context.max_effort_index}}" step="1" value="{{topic_context.effort_index}}" aria-label="{{t 'Thinking effort' }}" />
                    <div class="pear-effort-ticks">
                        {{#each topic_context.display_reasoning_efforts}}
                            <span class="{{#if selected}}selected{{/if}}">{{label}}</span>
                        {{/each}}
                    </div>
                </div>
            </section>
            {{#if model_error}}
                <div class="pear-panel-error">{{model_error}}</div>
            {{/if}}

            {{#if has_runs}}
                <div class="pear-run-list">
                    {{#each display_runs}}
                        <div class="pear-run-row" data-run-id="{{id}}">
                            <div class="pear-run-status-row pear-run-status-{{status_class}}{{#if flash_class}} {{flash_class}}{{/if}}">
                                <span class="pear-run-status-dot"></span>
                                <span class="pear-run-status-text">{{status_label}}</span>
                                {{#if show_session_kind}}
                                    <span class="pear-run-session-kind">{{session_kind_label}}</span>
                                {{/if}}
                                {{#if has_usage}}
                                    <span class="pear-run-status-usage tippy-zulip-delayed-tooltip" data-tippy-content="{{usage_title}}">
                                        {{usage_label}}
                                    </span>
                                {{/if}}
                            </div>
                            {{#if has_actions}}
                                <div class="pear-run-actions" data-run-id="{{id}}">
                                    {{#if can_pause}}
                                        <button type="button" class="pear-run-action icon-button icon-button-square icon-button-neutral tippy-zulip-delayed-tooltip" data-action="pause" data-run-id="{{id}}" aria-label="{{t 'Pause' }}" data-tippy-content="{{t 'Pause' }}">
                                            <i class="zulip-icon zulip-icon-stop-circle" aria-hidden="true"></i>
                                        </button>
                                    {{/if}}
                                    {{#if can_resume}}
                                        <button type="button" class="pear-run-action icon-button icon-button-square icon-button-neutral tippy-zulip-delayed-tooltip" data-action="resume" data-run-id="{{id}}" aria-label="{{t 'Resume' }}" data-tippy-content="{{t 'Resume' }}">
                                            <i class="zulip-icon zulip-icon-play-circle" aria-hidden="true"></i>
                                        </button>
                                    {{/if}}
                                    {{#if can_cancel}}
                                        <button type="button" class="pear-run-action icon-button icon-button-square icon-button-danger tippy-zulip-delayed-tooltip" data-action="cancel" data-run-id="{{id}}" aria-label="{{t 'Cancel' }}" data-tippy-content="{{t 'Cancel' }}">
                                            <i class="zulip-icon zulip-icon-circle-x" aria-hidden="true"></i>
                                        </button>
                                    {{/if}}
                                </div>
                            {{/if}}
                        </div>
                    {{/each}}
                </div>
            {{/if}}

            {{! R3: the chat header is authoritative for stream > topic ==
                repo > branch, so the panel shows only the git DELTA the
                header can't: dirty/clean, ahead/behind, detached HEAD,
                and the branch-differs-from-topic edge case. }}
            <section class="pear-context-section pear-git-section">
                <div class="pear-context-section-title">{{t "Git" }}</div>
                {{#if topic_context.git_available}}
                    <div class="pear-git-delta-row pear-git-{{topic_context.git_status_class}}">
                        <span class="pear-git-delta-pill pear-git-tree-target" tabindex="0" data-stream="{{topic_context.stream}}" data-topic="{{topic_context.topic}}" aria-label="{{t 'Git status; hover for the commit tree' }}">
                            <span class="pear-git-delta-status">{{topic_context.git_status_label}}</span>
                            {{#if topic_context.git_head_short}}
                                <span class="pear-git-delta-head">{{topic_context.git_head_short}}</span>
                            {{/if}}
                        </span>
                        {{#if topic_context.show_ahead_behind}}
                            <span class="pear-git-delta-chip pear-git-chip-ahead-behind tippy-zulip-delayed-tooltip" data-tippy-content="{{topic_context.ahead_behind_title}}">{{topic_context.ahead_behind_label}}</span>
                        {{/if}}
                        {{#if topic_context.show_detached}}
                            <span class="pear-git-delta-chip pear-git-chip-detached tippy-zulip-delayed-tooltip" data-tippy-content="{{topic_context.detached_title}}">{{t "detached HEAD" }}</span>
                        {{/if}}
                        {{#if topic_context.show_branch_mismatch}}
                            <span class="pear-git-delta-chip pear-git-chip-mismatch tippy-zulip-delayed-tooltip" data-tippy-content="{{topic_context.branch_mismatch_title}}">{{t "branch ≠ topic" }}</span>
                        {{/if}}
                    </div>
                {{else}}
                    <div class="pear-empty-state">{{t "No Git workspace." }}</div>
                {{/if}}
            </section>
        {{else}}
            <div class="pear-empty-state">{{t "Pear context is loading." }}</div>
        {{/if}}
    {{else}}
        <div class="pear-empty-state">{{t "Open a topic to see Pear context." }}</div>
    {{/if}}

    {{#if error}}
        <div class="pear-panel-error">{{error}}</div>
    {{/if}}

    <div class="pear-side">
        <textarea id="pear-side-request" class="pear-side-request" rows="2" placeholder="{{t 'Private side request' }}"></textarea>
        <button type="button" id="pear-side-start" class="pear-side-start action-button action-button-subtle-neutral" {{#unless has_topic}}disabled{{/unless}}>
            <span class="action-button-label">{{t "Side" }}</span>
        </button>
    </div>
</div>
