{
    "_about": [
        "The artifact contract: the JSON Schema an agent's artifact must satisfy, and",
        "the Codex tool that submits one. tools/armada/artifact_contract.py writes",
        "the server's and the web app's copies from this file; never edit those.",
        "The tool's description is kept as the lines the generated Python writes."
    ],
    "tool": {
        "name": "armada_artifact",
        "description": [
            "Create one Pear explainer or live-capable artifact. Use native semantic ",
            "blocks by default, or attach one bounded generated visual through a media ",
            "source under .armada/artifacts. Pear owns the frame, themes, and accessibility."
        ]
    },
    "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:armada:contract:artifact-v1",
        "title": "Armada artifact document",
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "blocks"],
        "properties": {
            "version": {
                "const": 1
            },
            "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
            },
            "data": {
                "type": "object",
                "maxProperties": 32,
                "additionalProperties": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/scalar"
                        },
                        {
                            "type": "array",
                            "maxItems": 256,
                            "items": {
                                "$ref": "#/$defs/scalar"
                            }
                        }
                    ]
                }
            },
            "blocks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                    "$ref": "#/$defs/block"
                }
            },
            "actions": {
                "type": "array",
                "maxItems": 4,
                "items": {
                    "$ref": "#/$defs/action"
                }
            }
        },
        "$defs": {
            "scalar": {
                "oneOf": [
                    {
                        "type": "string",
                        "maxLength": 2000
                    },
                    {
                        "type": "number"
                    },
                    {
                        "type": "boolean"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "action": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "prompt"],
                "properties": {
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                    },
                    "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                    }
                }
            },
            "state": {
                "type": "string",
                "enum": ["neutral", "running", "success", "warning", "error", "selected", "muted"]
            },
            "copyBlock": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "body"],
                "properties": {
                    "type": {
                        "const": "copy"
                    },
                    "eyebrow": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "heading": {
                        "type": "string",
                        "maxLength": 160
                    },
                    "body": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                    }
                }
            },
            "metricBlock": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "label", "value"],
                "properties": {
                    "type": {
                        "const": "metric"
                    },
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    },
                    "value": {
                        "$ref": "#/$defs/scalar"
                    },
                    "bind": {
                        "type": "string",
                        "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
                    },
                    "unit": {
                        "type": "string",
                        "maxLength": 24
                    },
                    "delta": {
                        "type": "number"
                    },
                    "state": {
                        "$ref": "#/$defs/state"
                    }
                }
            },
            "meterBlock": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "label", "value"],
                "properties": {
                    "type": {
                        "const": "meter"
                    },
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    },
                    "value": {
                        "type": "number"
                    },
                    "bind": {
                        "type": "string",
                        "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
                    },
                    "total": {
                        "type": "number",
                        "exclusiveMinimum": 0
                    },
                    "unit": {
                        "type": "string",
                        "maxLength": 24
                    },
                    "detail": {
                        "type": "string",
                        "maxLength": 160
                    },
                    "state": {
                        "$ref": "#/$defs/state"
                    }
                }
            },
            "seriesBlock": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "label", "values"],
                "properties": {
                    "type": {
                        "const": "series"
                    },
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    },
                    "values": {
                        "type": "array",
                        "maxItems": 256,
                        "items": {
                            "type": "number"
                        }
                    },
                    "bind": {
                        "type": "string",
                        "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
                    },
                    "unit": {
                        "type": "string",
                        "maxLength": 24
                    },
                    "state": {
                        "$ref": "#/$defs/state"
                    }
                }
            },
            "logBlock": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "label", "lines"],
                "properties": {
                    "type": {
                        "const": "log"
                    },
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    },
                    "lines": {
                        "type": "array",
                        "maxItems": 50,
                        "items": {
                            "type": "string",
                            "maxLength": 300
                        }
                    },
                    "bind": {
                        "type": "string",
                        "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
                    },
                    "state": {
                        "$ref": "#/$defs/state"
                    }
                }
            },
            "keyValueBlock": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "label", "items"],
                "properties": {
                    "type": {
                        "const": "key_value"
                    },
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    },
                    "items": {
                        "type": "array",
                        "maxItems": 16,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["key", "value"],
                            "properties": {
                                "key": {
                                    "type": "string",
                                    "maxLength": 80
                                },
                                "value": {
                                    "$ref": "#/$defs/scalar"
                                }
                            }
                        }
                    }
                }
            },
            "mediaBlock": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "kind", "alt"],
                "properties": {
                    "type": {
                        "const": "media"
                    },
                    "kind": {
                        "type": "string",
                        "enum": ["image", "video"]
                    },
                    "source": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240,
                        "pattern": "^\\.armada/artifacts/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:png|svg|webp|webm)$"
                    },
                    "src": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "pattern": "^/user_uploads/[A-Za-z0-9_./-]+$"
                    },
                    "sourceDark": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240,
                        "pattern": "^\\.armada/artifacts/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:png|svg|webp|webm)$"
                    },
                    "srcDark": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "pattern": "^/user_uploads/[A-Za-z0-9_./-]+$"
                    },
                    "posterSource": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240,
                        "pattern": "^\\.armada/artifacts/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:png|webp)$"
                    },
                    "poster": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "pattern": "^/user_uploads/[A-Za-z0-9_./-]+$"
                    },
                    "posterSourceDark": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240,
                        "pattern": "^\\.armada/artifacts/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:png|webp)$"
                    },
                    "posterDark": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "pattern": "^/user_uploads/[A-Za-z0-9_./-]+$"
                    },
                    "alt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                    },
                    "caption": {
                        "type": "string",
                        "maxLength": 500
                    },
                    "aspect": {
                        "type": "string",
                        "enum": ["wide", "standard", "square", "tall"]
                    },
                    "motion": {
                        "type": "string",
                        "enum": ["once", "loop", "manual"]
                    }
                }
            },
            "sceneBlock": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "label", "root"],
                "properties": {
                    "type": {
                        "const": "scene"
                    },
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                    },
                    "aspect": {
                        "type": "string",
                        "enum": ["wide", "standard", "square", "tall"]
                    },
                    "root": {
                        "$ref": "#/$defs/node"
                    },
                    "steps": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 12,
                        "items": {
                            "$ref": "#/$defs/sceneStep"
                        }
                    }
                }
            },
            "block": {
                "oneOf": [
                    {
                        "$ref": "#/$defs/copyBlock"
                    },
                    {
                        "$ref": "#/$defs/metricBlock"
                    },
                    {
                        "$ref": "#/$defs/meterBlock"
                    },
                    {
                        "$ref": "#/$defs/seriesBlock"
                    },
                    {
                        "$ref": "#/$defs/logBlock"
                    },
                    {
                        "$ref": "#/$defs/keyValueBlock"
                    },
                    {
                        "$ref": "#/$defs/mediaBlock"
                    },
                    {
                        "$ref": "#/$defs/sceneBlock"
                    }
                ]
            },
            "point": {
                "type": "array",
                "prefixItems": [
                    {
                        "type": "number"
                    },
                    {
                        "type": "number"
                    }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
            },
            "derive": {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "args"],
                "properties": {
                    "op": {
                        "type": "string",
                        "enum": [
                            "add",
                            "subtract",
                            "multiply",
                            "divide",
                            "min",
                            "max",
                            "clamp",
                            "equal",
                            "greater",
                            "less",
                            "and",
                            "or",
                            "not"
                        ]
                    },
                    "args": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 4,
                        "items": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/scalar"
                                },
                                {
                                    "type": "string",
                                    "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
                                }
                            ]
                        }
                    }
                }
            },
            "sceneStepChange": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 2,
                "required": ["target"],
                "properties": {
                    "target": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
                    },
                    "state": {
                        "$ref": "#/$defs/state"
                    },
                    "label": {
                        "type": "string",
                        "maxLength": 160
                    },
                    "text": {
                        "type": "string",
                        "maxLength": 1000
                    }
                }
            },
            "sceneStep": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "changes"],
                "properties": {
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                    },
                    "changes": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 32,
                        "items": {
                            "$ref": "#/$defs/sceneStepChange"
                        }
                    }
                }
            },
            "node": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "x-armada-type-properties": {
                    "group": [
                        "type",
                        "id",
                        "state",
                        "layout",
                        "columns",
                        "align",
                        "children",
                        "repeat",
                        "transition",
                        "interaction",
                        "ariaLabel"
                    ],
                    "text": [
                        "type",
                        "id",
                        "state",
                        "text",
                        "textRole",
                        "bind",
                        "derive",
                        "repeat",
                        "transition",
                        "interaction",
                        "ariaLabel"
                    ],
                    "shape": [
                        "type",
                        "id",
                        "state",
                        "shape",
                        "label",
                        "repeat",
                        "transition",
                        "interaction",
                        "ariaLabel"
                    ],
                    "connector": ["type", "id", "state", "from", "to", "directed", "label"],
                    "path": [
                        "type",
                        "id",
                        "state",
                        "points",
                        "closed",
                        "repeat",
                        "transition",
                        "interaction",
                        "ariaLabel"
                    ],
                    "symbol": [
                        "type",
                        "id",
                        "state",
                        "symbol",
                        "repeat",
                        "transition",
                        "interaction",
                        "ariaLabel"
                    ],
                    "mark": [
                        "type",
                        "id",
                        "state",
                        "mark",
                        "values",
                        "bind",
                        "repeat",
                        "transition",
                        "interaction",
                        "ariaLabel"
                    ],
                    "control": [
                        "type",
                        "id",
                        "state",
                        "control",
                        "action",
                        "value",
                        "min",
                        "max",
                        "step",
                        "label",
                        "repeat",
                        "transition",
                        "ariaLabel"
                    ]
                },
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "group",
                            "text",
                            "shape",
                            "connector",
                            "path",
                            "symbol",
                            "mark",
                            "control"
                        ]
                    },
                    "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
                    },
                    "state": {
                        "$ref": "#/$defs/state"
                    },
                    "layout": {
                        "type": "string",
                        "enum": ["row", "column", "grid", "graph", "overlay"]
                    },
                    "columns": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 6
                    },
                    "align": {
                        "type": "string",
                        "enum": ["start", "center", "end", "stretch", "between"]
                    },
                    "children": {
                        "type": "array",
                        "maxItems": 64,
                        "items": {
                            "$ref": "#/$defs/node"
                        }
                    },
                    "text": {
                        "type": "string",
                        "maxLength": 1000
                    },
                    "textRole": {
                        "type": "string",
                        "enum": ["title", "label", "body", "value", "note", "mono"]
                    },
                    "bind": {
                        "type": "string",
                        "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
                    },
                    "derive": {
                        "$ref": "#/$defs/derive"
                    },
                    "shape": {
                        "type": "string",
                        "enum": ["rectangle", "circle", "ellipse", "line", "pill", "diamond"]
                    },
                    "from": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
                    },
                    "to": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
                    },
                    "directed": {
                        "type": "boolean"
                    },
                    "label": {
                        "type": "string",
                        "maxLength": 160
                    },
                    "points": {
                        "type": "array",
                        "maxItems": 64,
                        "items": {
                            "$ref": "#/$defs/point"
                        }
                    },
                    "closed": {
                        "type": "boolean"
                    },
                    "symbol": {
                        "type": "string",
                        "enum": [
                            "arrow",
                            "check",
                            "warning",
                            "error",
                            "play",
                            "pause",
                            "clock",
                            "file",
                            "folder",
                            "code",
                            "person",
                            "agent"
                        ]
                    },
                    "mark": {
                        "type": "string",
                        "enum": ["bar", "line", "point", "area", "arc"]
                    },
                    "values": {
                        "type": "array",
                        "maxItems": 256,
                        "items": {
                            "type": "number"
                        }
                    },
                    "control": {
                        "type": "string",
                        "enum": ["button", "toggle", "range", "stepper"]
                    },
                    "action": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "value": {
                        "$ref": "#/$defs/scalar"
                    },
                    "min": {
                        "type": "number"
                    },
                    "max": {
                        "type": "number"
                    },
                    "step": {
                        "type": "number",
                        "exclusiveMinimum": 0
                    },
                    "repeat": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["source"],
                        "properties": {
                            "source": {
                                "type": "string",
                                "pattern": "^data\\.[A-Za-z0-9_.-]{1,80}$"
                            },
                            "limit": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 64
                            }
                        }
                    },
                    "transition": {
                        "type": "string",
                        "enum": ["none", "value", "position", "enter_exit"]
                    },
                    "interaction": {
                        "type": "string",
                        "enum": ["none", "select", "toggle", "filter", "step"]
                    },
                    "ariaLabel": {
                        "type": "string",
                        "maxLength": 240
                    }
                }
            }
        }
    }
}
