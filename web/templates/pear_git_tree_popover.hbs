<div class="pear-git-tree-popover">
    {{#if loading}}
        <div class="pear-git-tree-note">{{t "Loading commit tree…" }}</div>
    {{else if available}}
        <pre class="pear-git-tree-graph">{{graph}}</pre>
        {{#if status_short}}
            <pre class="pear-git-tree-status">{{status_short}}</pre>
        {{/if}}
    {{else}}
        <div class="pear-git-tree-note">{{t "Commit tree unavailable." }}</div>
    {{/if}}
</div>
