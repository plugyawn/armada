{
    "_about": [
        "The plugin contract (design/r9/plugins, section 2 and 4): the manifest a plugin's",
        "repository carries as armada-plugin.json, and what its widget document adds to the",
        "artifact contract (tools/armada/artifact_contract.json). tools/armada/artifact_contract.py",
        "composes the widget schema from both and writes the server's and the web app's copies;",
        "never edit those. Glyph names and run states are filled in from the sprite",
        "(tools/armada/icons_gen.py), so a plugin can only name what the kit draws."
    ],
    "api_version": 1,
    "manifest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:armada:contract:plugin-manifest-v1",
        "title": "Armada plugin manifest",
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "description", "glyph", "requires", "provides"],
        "properties": {
            "id": {
                "$ref": "#/$defs/id"
            },
            "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
            },
            "version": {
                "type": "string",
                "maxLength": 32,
                "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}(?:-[0-9A-Za-z.-]{1,16})?$"
            },
            "author": {
                "type": "string",
                "maxLength": 60
            },
            "license": {
                "type": "string",
                "maxLength": 40
            },
            "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
            },
            "glyph": {
                "$ref": "#/$defs/glyph"
            },
            "requires": {
                "type": "object",
                "additionalProperties": false,
                "required": ["armada"],
                "properties": {
                    "armada": {
                        "type": "string",
                        "pattern": "^>=[1-9][0-9]{0,2}$"
                    }
                }
            },
            "run": {
                "type": "object",
                "additionalProperties": false,
                "required": ["command"],
                "properties": {
                    "setup": {
                        "$ref": "#/$defs/argv"
                    },
                    "command": {
                        "$ref": "#/$defs/argv"
                    }
                }
            },
            "remote": {
                "type": "object",
                "additionalProperties": false,
                "required": ["url"],
                "properties": {
                    "url": {
                        "type": "string",
                        "maxLength": 300,
                        "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~/-]*)?$"
                    }
                }
            },
            "settings": {
                "$ref": "#/$defs/settings"
            },
            "secrets": {
                "type": "object",
                "maxProperties": 8,
                "propertyNames": {
                    "$ref": "#/$defs/key"
                },
                "additionalProperties": {
                    "$ref": "#/$defs/secret"
                }
            },
            "provides": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "widgets": {
                        "type": "array",
                        "maxItems": 4,
                        "items": {
                            "$ref": "#/$defs/widget"
                        }
                    },
                    "links": {
                        "type": "object",
                        "maxProperties": 4,
                        "propertyNames": {
                            "$ref": "#/$defs/key"
                        },
                        "additionalProperties": {
                            "$ref": "#/$defs/link"
                        }
                    },
                    "tools": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["path"],
                        "properties": {
                            "path": {
                                "type": "string",
                                "pattern": "^/[A-Za-z0-9._~/-]{0,100}$"
                            },
                            "instructions": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 300
                            }
                        }
                    },
                    "events": {
                        "type": "array",
                        "maxItems": 8,
                        "items": {
                            "type": "string",
                            "enum": [
                                "message",
                                "update_message",
                                "delete_message",
                                "reaction",
                                "agent_run",
                                "armada_plugin"
                            ]
                        }
                    },
                    "posts": {
                        "type": "boolean"
                    }
                }
            },
            "reaches": {
                "type": "array",
                "maxItems": 16,
                "items": {
                    "type": "string",
                    "maxLength": 253,
                    "pattern": "^(?:\\*\\.)?[A-Za-z0-9-]{1,63}(?:\\.[A-Za-z0-9-]{1,63})+$"
                }
            }
        },
        "$defs": {
            "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$"
            },
            "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
            },
            "glyph": {
                "type": "string",
                "enum": "x-armada-sprite-glyphs"
            },
            "scalar": {
                "oneOf": [
                    {
                        "type": "string",
                        "maxLength": 200
                    },
                    {
                        "type": "number"
                    },
                    {
                        "type": "boolean"
                    }
                ]
            },
            "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                }
            },
            "settings": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "properties"],
                "properties": {
                    "type": {
                        "const": "object"
                    },
                    "required": {
                        "type": "array",
                        "maxItems": 16,
                        "items": {
                            "$ref": "#/$defs/key"
                        }
                    },
                    "properties": {
                        "type": "object",
                        "maxProperties": 16,
                        "propertyNames": {
                            "$ref": "#/$defs/key"
                        },
                        "additionalProperties": {
                            "$ref": "#/$defs/setting"
                        }
                    }
                }
            },
            "setting": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title"],
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": ["string", "integer", "number", "boolean", "array"]
                    },
                    "enum": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 16,
                        "items": {
                            "$ref": "#/$defs/scalar"
                        }
                    },
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["type"],
                        "properties": {
                            "type": {
                                "type": "string",
                                "enum": ["string", "integer", "number"]
                            },
                            "maxLength": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 2000
                            },
                            "pattern": {
                                "type": "string",
                                "maxLength": 200
                            }
                        }
                    },
                    "maxItems": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 64
                    },
                    "minLength": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2000
                    },
                    "maxLength": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2000
                    },
                    "pattern": {
                        "type": "string",
                        "maxLength": 200
                    },
                    "minimum": {
                        "type": "number"
                    },
                    "maximum": {
                        "type": "number"
                    },
                    "default": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/scalar"
                            },
                            {
                                "type": "array",
                                "maxItems": 64,
                                "items": {
                                    "$ref": "#/$defs/scalar"
                                }
                            }
                        ]
                    },
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 200
                    }
                }
            },
            "secret": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "env"],
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                    },
                    "env": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
                    },
                    "required": {
                        "type": "boolean"
                    },
                    "help": {
                        "type": "string",
                        "maxLength": 200
                    }
                }
            },
            "widget": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "label", "in"],
                "properties": {
                    "key": {
                        "$ref": "#/$defs/key"
                    },
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 24
                    },
                    "in": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 3,
                        "items": {
                            "type": "string",
                            "enum": ["nav", "column", "open"]
                        }
                    },
                    "column_slots": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3
                    },
                    "cadence": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 86400
                    },
                    "team_default": {
                        "type": "string",
                        "enum": ["shown", "offered"]
                    },
                    "options": {
                        "$ref": "#/$defs/options"
                    }
                }
            },
            "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "figures": {
                        "type": "array",
                        "maxItems": 8,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["key", "title", "figure", "sizer"],
                            "properties": {
                                "key": {
                                    "$ref": "#/$defs/key"
                                },
                                "title": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 40
                                },
                                "figure": {
                                    "$ref": "#/$defs/binding"
                                },
                                "sizer": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 12
                                }
                            }
                        }
                    },
                    "facets": {
                        "type": "array",
                        "maxItems": 4,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["key", "title"],
                            "properties": {
                                "key": {
                                    "$ref": "#/$defs/key"
                                },
                                "title": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 40
                                }
                            }
                        }
                    },
                    "alerts": {
                        "type": "array",
                        "maxItems": 8,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["key", "title", "value", "op"],
                            "properties": {
                                "key": {
                                    "$ref": "#/$defs/key"
                                },
                                "title": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 60
                                },
                                "value": {
                                    "$ref": "#/$defs/binding"
                                },
                                "op": {
                                    "type": "string",
                                    "enum": [">=", "<="]
                                },
                                "min": {
                                    "type": "number"
                                },
                                "max": {
                                    "type": "number"
                                }
                            }
                        }
                    }
                }
            },
            "binding": {
                "type": "string",
                "pattern": "^data\\.[A-Za-z0-9_-]{1,80}$"
            },
            "link": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "to"],
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                    },
                    "to": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 2,
                        "items": {
                            "type": "string",
                            "enum": ["channel", "topic"]
                        }
                    },
                    "pattern": {
                        "type": "string",
                        "maxLength": 200
                    }
                }
            }
        }
    },
    "widget": {
        "$id": "urn:armada:contract:widget-v1",
        "title": "Armada plugin widget document",
        "_about": [
            "The artifact document, with no media block (a plugin brings no images), one more",
            "block (list), one more field (rest), tool and link actions beside prompt actions, and data",
            "that may hold a list's rows, so that a list is bound as other blocks are."
        ],
        "drop_blocks": ["mediaBlock"],
        "properties": {
            "rest": {
                "$ref": "#/$defs/rest"
            }
        },
        "action": {
            "oneOf": [
                {
                    "$ref": "#/$defs/action"
                },
                {
                    "$ref": "#/$defs/toolAction"
                },
                {
                    "$ref": "#/$defs/linkAction"
                }
            ]
        },
        "data_value": {
            "type": "array",
            "maxItems": 32,
            "items": {
                "$ref": "#/$defs/listItem"
            }
        },
        "$defs": {
            "glyph": {
                "type": "string",
                "enum": "x-armada-sprite-glyphs"
            },
            "runState": {
                "type": "string",
                "enum": "x-armada-sprite-marks"
            },
            "httpUrl": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^https?://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:[/?#][^\\s<>\"'`\\\\]*)?$"
            },
            "linkAction": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "url"],
                "properties": {
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                    },
                    "url": {
                        "$ref": "#/$defs/httpUrl"
                    }
                }
            },
            "binding": {
                "type": "string",
                "pattern": "^data\\.[A-Za-z0-9_-]{1,80}$"
            },
            "rest": {
                "type": "object",
                "additionalProperties": false,
                "required": ["figure", "sizer"],
                "properties": {
                    "figure": {
                        "$ref": "#/$defs/binding"
                    },
                    "news": {
                        "$ref": "#/$defs/binding"
                    },
                    "sizer": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 12
                    }
                }
            },
            "toolAction": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "tool"],
                "properties": {
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                    },
                    "tool": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                    },
                    "arguments": {
                        "type": "object",
                        "maxProperties": 16,
                        "additionalProperties": {
                            "oneOf": [
                                {
                                    "$ref": "#/$defs/scalar"
                                },
                                {
                                    "type": "array",
                                    "maxItems": 32,
                                    "items": {
                                        "$ref": "#/$defs/scalar"
                                    }
                                }
                            ]
                        }
                    },
                    "confirm": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    }
                }
            },
            "spark": {
                "type": "object",
                "additionalProperties": false,
                "required": ["values"],
                "properties": {
                    "values": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 120,
                        "items": {
                            "type": "number"
                        }
                    },
                    "domain": {
                        "$ref": "#/$defs/point"
                    }
                }
            },
            "listItem": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "label"],
                "properties": {
                    "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
                    },
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    },
                    "code": {
                        "type": "boolean"
                    },
                    "sub": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "state": {
                        "$ref": "#/$defs/runState"
                    },
                    "glyph": {
                        "$ref": "#/$defs/glyph"
                    },
                    "spark": {
                        "$ref": "#/$defs/spark"
                    },
                    "facets": {
                        "type": "object",
                        "maxProperties": 4,
                        "propertyNames": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]{0,31}$"
                        },
                        "additionalProperties": {
                            "oneOf": [
                                {
                                    "type": "string",
                                    "maxLength": 80
                                },
                                {
                                    "type": "number"
                                },
                                {
                                    "type": "boolean"
                                }
                            ]
                        }
                    },
                    "figure": {
                        "oneOf": [
                            {
                                "type": "string",
                                "maxLength": 24
                            },
                            {
                                "type": "number"
                            }
                        ]
                    },
                    "open": {
                        "oneOf": [
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["url"],
                                "properties": {
                                    "url": {
                                        "$ref": "#/$defs/httpUrl"
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["widget"],
                                "properties": {
                                    "widget": {
                                        "type": "string",
                                        "pattern": "^[a-z][a-z0-9_]{0,31}$"
                                    }
                                }
                            }
                        ]
                    },
                    "action": {
                        "$ref": "#/$defs/widgetAction"
                    }
                }
            },
            "listBlock": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "label"],
                "properties": {
                    "type": {
                        "const": "list"
                    },
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    },
                    "caption": {
                        "type": "string",
                        "maxLength": 24
                    },
                    "slots": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3
                    },
                    "items": {
                        "type": "array",
                        "maxItems": 32,
                        "items": {
                            "$ref": "#/$defs/listItem"
                        }
                    },
                    "bind": {
                        "$ref": "#/$defs/binding"
                    }
                }
            }
        }
    }
}
