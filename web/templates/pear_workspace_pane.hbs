<div class="pear-workspace-pane-inner">
    <div class="pear-workspace-pane-header">
        <span class="pear-workspace-pane-crumb">{{context_label}}</span>
        <span class="pear-workspace-tabs" role="tablist">
            <button type="button" class="pear-workspace-tab" data-pear-tab="chat" role="tab">{{t "Chat" }}</button>
            <button type="button" class="pear-workspace-tab {{#if is_canvas}}pear-workspace-tab-selected{{/if}}" data-pear-tab="canvas" role="tab">{{t "Canvas" }}</button>
            <button type="button" class="pear-workspace-tab {{#if is_files}}pear-workspace-tab-selected{{/if}}" data-pear-tab="files" role="tab">{{t "Files" }}</button>
        </span>
        {{#if is_canvas}}
        <span class="pear-canvas-status"></span>
        {{/if}}
        <span class="pear-workspace-pane-hint">{{t "Esc returns to chat" }}</span>
    </div>
    {{#if is_canvas}}
    <div class="pear-workspace-pane-body pear-canvas-body">
        <textarea class="pear-canvas-editor" spellcheck="true" placeholder="{{t 'The topic canvas — durable notes, plans, and context. Pear reads and writes this file too.' }}"></textarea>
    </div>
    {{else}}
    <div class="pear-workspace-pane-body"></div>
    {{/if}}
</div>
