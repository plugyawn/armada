<div class="pear-workspace-pane-inner">
    <div class="pear-workspace-pane-header">
        <button type="button" class="pear-workspace-tab pear-pane-back" data-pear-tab="chat" aria-label="{{t 'Back to chat' }}">&larr; {{t "chat" }}</button>
        <span class="pear-workspace-pane-crumb">{{context_label}}</span>
        {{! The same live topic-header cluster the chat shows — model
            pill, commit line, tab strip — injected and kept fresh by
            pear_panel, so nothing visually changes across tabs. }}
        <span class="pear-pane-header-cluster"></span>
        <span class="pear-canvas-status"></span>
        <span class="pear-workspace-pane-hint">{{t "Esc returns to chat" }}</span>
    </div>
    <div class="pear-workspace-pane-body pear-canvas-body pear-body-hidden" tabindex="-1"></div>
    <div class="pear-workspace-pane-body pear-files-body pear-body-hidden"></div>
</div>
