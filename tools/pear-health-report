#!/usr/bin/env python3
"""Report whether the live Pear worker state is plausibly stuck."""

from __future__ import annotations

import argparse
import json
import os
import sys
from dataclasses import dataclass
from datetime import timedelta
from pathlib import Path
from typing import Any


BASE_DIR = Path(__file__).resolve().parents[1]


@dataclass(frozen=True)
class PearHealthReport:
    active_run_count: int
    stale_active_run_count: int
    orphan_active_marker_count: int
    old_orphan_active_marker_count: int
    stale_run_age_seconds: int
    stale_marker_age_seconds: int
    marker_window_seconds: int
    active_run_samples: list[dict[str, Any]]
    stale_active_run_samples: list[dict[str, Any]]
    orphan_active_marker_samples: list[dict[str, Any]]
    old_orphan_active_marker_samples: list[dict[str, Any]]


@dataclass(frozen=True)
class PearMarkerSettlement:
    message_id: int
    sender_id: int
    topic: str
    old_content: str
    new_content: str
    dry_run: bool
    error: str | None = None


def health_violations(
    report: PearHealthReport,
    *,
    max_active_runs: int,
    max_stale_active_runs: int,
    max_orphan_active_markers: int,
    max_old_orphan_active_markers: int | None,
) -> list[str]:
    violations = []
    if report.active_run_count > max_active_runs:
        violations.append(
            f"active_run_count={report.active_run_count} exceeds {max_active_runs}"
        )
    if report.stale_active_run_count > max_stale_active_runs:
        violations.append(
            f"stale_active_run_count={report.stale_active_run_count} exceeds "
            f"{max_stale_active_runs}"
        )
    if report.orphan_active_marker_count > max_orphan_active_markers:
        violations.append(
            f"orphan_active_marker_count={report.orphan_active_marker_count} exceeds "
            f"{max_orphan_active_markers}"
        )
    if (
        max_old_orphan_active_markers is not None
        and report.old_orphan_active_marker_count > max_old_orphan_active_markers
    ):
        violations.append(
            "old_orphan_active_marker_count="
            f"{report.old_orphan_active_marker_count} exceeds {max_old_orphan_active_markers}"
        )
    return violations


def report_to_json(report: PearHealthReport) -> dict[str, Any]:
    return {
        "active_run_count": report.active_run_count,
        "stale_active_run_count": report.stale_active_run_count,
        "orphan_active_marker_count": report.orphan_active_marker_count,
        "old_orphan_active_marker_count": report.old_orphan_active_marker_count,
        "stale_run_age_seconds": report.stale_run_age_seconds,
        "stale_marker_age_seconds": report.stale_marker_age_seconds,
        "marker_window_seconds": report.marker_window_seconds,
        "active_run_samples": report.active_run_samples,
        "stale_active_run_samples": report.stale_active_run_samples,
        "orphan_active_marker_samples": report.orphan_active_marker_samples,
        "old_orphan_active_marker_samples": report.old_orphan_active_marker_samples,
    }


def render_report(report: PearHealthReport) -> str:
    lines = [
        "Pear live health:",
        f"active_runs={report.active_run_count}",
        f"stale_active_runs={report.stale_active_run_count}",
        f"orphan_active_markers={report.orphan_active_marker_count}",
        f"old_orphan_active_markers={report.old_orphan_active_marker_count}",
        f"stale_run_age_seconds={report.stale_run_age_seconds}",
        f"stale_marker_age_seconds={report.stale_marker_age_seconds}",
        f"marker_window_seconds={report.marker_window_seconds}",
    ]
    if report.active_run_samples:
        lines.append("active_run_samples:")
        lines.extend(f"- {sample}" for sample in report.active_run_samples)
    if report.stale_active_run_samples:
        lines.append("stale_active_run_samples:")
        lines.extend(f"- {sample}" for sample in report.stale_active_run_samples)
    if report.orphan_active_marker_samples:
        lines.append("orphan_active_marker_samples:")
        lines.extend(f"- {sample}" for sample in report.orphan_active_marker_samples)
    if report.old_orphan_active_marker_samples:
        lines.append("old_orphan_active_marker_samples:")
        lines.extend(f"- {sample}" for sample in report.old_orphan_active_marker_samples)
    return "\n".join(lines)


def settled_active_marker_content(content: str, pear_active_markdown_prefix: str) -> str:
    text = content.rstrip()
    if not text.endswith(pear_active_markdown_prefix):
        return content
    settled_content = text[: -len(pear_active_markdown_prefix)].rstrip()
    if settled_content in {"", "*Thinking*", "_Thinking_", "Thinking"}:
        return "Pear worker is no longer marked active."
    return settled_content


def render_settlement_results(settlements: list[PearMarkerSettlement]) -> str:
    if not settlements:
        return "No old orphan active markers to settle."
    mode = "dry-run" if settlements[0].dry_run else "applied"
    lines = [f"Pear marker settlements ({mode}):"]
    for settlement in settlements:
        status = f"ERROR: {settlement.error}" if settlement.error else "ok"
        lines.append(
            "- "
            f"id={settlement.message_id} sender={settlement.sender_id} "
            f"topic={settlement.topic!r} status={status} "
            f"new_content={settlement.new_content!r}"
        )
    return "\n".join(lines)


def setup_django() -> tuple[Any, Any, Any, str, int, Any]:
    sys.path.append(str(BASE_DIR))
    from scripts.lib.setup_path import setup_path

    setup_path()

    os.environ.setdefault("DJANGO_SETTINGS_MODULE", "zproject.settings")

    import django

    django.setup()

    from django.db.models import Q
    from django.utils.timezone import now as timezone_now
    from zerver.lib.pear import PEAR_ACTIVE_MARKDOWN_PREFIX
    from zerver.lib.pear_worker import pear_worker_stale_after_seconds
    from zerver.models.bots import PearWorkerRun
    from zerver.models.messages import Message

    return (
        PearWorkerRun,
        Message,
        Q,
        PEAR_ACTIVE_MARKDOWN_PREFIX,
        pear_worker_stale_after_seconds(),
        timezone_now,
    )


def old_orphan_active_marker_queryset(
    Message: Any,
    *,
    pear_active_markdown_prefix: str,
    marker_window_cutoff: Any,
    active_result_message_ids: set[int],
) -> Any:
    return (
        Message.objects.filter(
            content__contains=pear_active_markdown_prefix,
            date_sent__lt=marker_window_cutoff,
        )
        .exclude(id__in=active_result_message_ids)
        .order_by("-date_sent", "-id")
    )


def run_sample(run: Any) -> dict[str, Any]:
    return {
        "id": run.id,
        "status": run.status,
        "stream": run.stream_name,
        "topic": run.topic_name,
        "result_message_id": run.result_message_id,
        "date_updated": run.date_updated.isoformat(),
        "heartbeat_at": run.heartbeat_at.isoformat() if run.heartbeat_at else None,
    }


def marker_sample(message: Any) -> dict[str, Any]:
    return {
        "id": message.id,
        "sender_id": message.sender_id,
        "date_sent": message.date_sent.isoformat(),
        "topic": message.topic_name(),
        "content": message.content[:200].replace("\n", " "),
    }


def collect_health(
    *,
    stale_run_age_seconds: int | None,
    stale_marker_age_seconds: int,
    marker_window_seconds: int,
    sample_limit: int,
) -> PearHealthReport:
    (
        PearWorkerRun,
        Message,
        Q,
        pear_active_markdown_prefix,
        default_stale_run_age_seconds,
        timezone_now,
    ) = setup_django()
    stale_run_age_seconds = stale_run_age_seconds or default_stale_run_age_seconds
    current_time = timezone_now()
    active_runs = PearWorkerRun.objects.filter(status__in=["queued", "running"]).order_by(
        "-date_updated",
        "-id",
    )
    stale_run_cutoff = current_time - timedelta(seconds=stale_run_age_seconds)
    stale_active_runs = active_runs.filter(
        Q(status="queued", date_updated__lte=stale_run_cutoff)
        | Q(status="running", heartbeat_at__lte=stale_run_cutoff)
        | Q(status="running", heartbeat_at__isnull=True, date_updated__lte=stale_run_cutoff)
    ).order_by("-date_updated", "-id")

    active_result_message_ids = set(
        active_runs.exclude(result_message_id=None).values_list("result_message_id", flat=True)
    )
    marker_old_cutoff = current_time - timedelta(seconds=stale_marker_age_seconds)
    marker_window_cutoff = current_time - timedelta(seconds=marker_window_seconds)
    orphan_active_markers = (
        Message.objects.filter(
            content__contains=pear_active_markdown_prefix,
            date_sent__gte=marker_window_cutoff,
            date_sent__lte=marker_old_cutoff,
        )
        .exclude(id__in=active_result_message_ids)
        .order_by("-date_sent", "-id")
    )
    old_orphan_active_markers = old_orphan_active_marker_queryset(
        Message,
        pear_active_markdown_prefix=pear_active_markdown_prefix,
        marker_window_cutoff=marker_window_cutoff,
        active_result_message_ids=active_result_message_ids,
    )

    return PearHealthReport(
        active_run_count=active_runs.count(),
        stale_active_run_count=stale_active_runs.count(),
        orphan_active_marker_count=orphan_active_markers.count(),
        old_orphan_active_marker_count=old_orphan_active_markers.count(),
        stale_run_age_seconds=stale_run_age_seconds,
        stale_marker_age_seconds=stale_marker_age_seconds,
        marker_window_seconds=marker_window_seconds,
        active_run_samples=[run_sample(run) for run in active_runs[:sample_limit]],
        stale_active_run_samples=[
            run_sample(run) for run in stale_active_runs[:sample_limit]
        ],
        orphan_active_marker_samples=[
            marker_sample(message) for message in orphan_active_markers[:sample_limit]
        ],
        old_orphan_active_marker_samples=[
            marker_sample(message) for message in old_orphan_active_markers[:sample_limit]
        ],
    )


def update_message_content_as_sender_without_edit_limit(message: Any, content: str) -> None:
    from django.db import transaction
    from zerver.actions.message_edit import (
        build_message_edit_request,
        do_update_message,
        get_mentions_for_message_updates,
    )
    from zerver.actions.message_send import render_incoming_message
    from zerver.lib.mention import MentionBackend, MentionData

    Message = type(message)
    with transaction.atomic(durable=True):
        locked_message = Message.objects.select_for_update().get(id=message.id)
        user_profile = locked_message.sender
        mention_backend = MentionBackend(user_profile.realm_id)
        mention_data = MentionData(
            mention_backend=mention_backend,
            content=content,
            message_sender=locked_message.sender,
        )
        rendering_result = render_incoming_message(
            locked_message,
            content,
            user_profile.realm,
            mention_data=mention_data,
        )
        message_edit_request = build_message_edit_request(
            message=locked_message,
            user_profile=user_profile,
            propagate_mode="change_one",
            stream_id=None,
            topic_name=None,
            content=content,
        )
        do_update_message(
            user_profile,
            locked_message,
            message_edit_request,
            False,
            False,
            rendering_result,
            get_mentions_for_message_updates(locked_message),
            mention_data,
        )


def settle_old_orphan_active_markers(
    *,
    marker_window_seconds: int,
    limit: int,
    dry_run: bool,
) -> list[PearMarkerSettlement]:
    (
        PearWorkerRun,
        Message,
        _Q,
        pear_active_markdown_prefix,
        _default_stale_run_age_seconds,
        timezone_now,
    ) = setup_django()
    active_runs = PearWorkerRun.objects.filter(status__in=["queued", "running"])
    active_result_message_ids = set(
        active_runs.exclude(result_message_id=None).values_list("result_message_id", flat=True)
    )
    marker_window_cutoff = timezone_now() - timedelta(seconds=marker_window_seconds)
    old_markers = old_orphan_active_marker_queryset(
        Message,
        pear_active_markdown_prefix=pear_active_markdown_prefix,
        marker_window_cutoff=marker_window_cutoff,
        active_result_message_ids=active_result_message_ids,
    )
    settlements = []
    for message in old_markers[:limit]:
        new_content = settled_active_marker_content(message.content, pear_active_markdown_prefix)
        error = None
        if new_content == message.content:
            error = "active marker is not a trailing marker"
        elif not dry_run:
            try:
                update_message_content_as_sender_without_edit_limit(message, new_content)
            except Exception as exception:
                error = str(exception)
        settlements.append(
            PearMarkerSettlement(
                message_id=message.id,
                sender_id=message.sender_id,
                topic=message.topic_name(),
                old_content=message.content,
                new_content=new_content,
                dry_run=dry_run,
                error=error,
            )
        )
    return settlements


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Report live Pear worker health from the Zulip database. "
            "Run inside the Zulip checkout, usually with pear.env loaded on the box."
        )
    )
    parser.add_argument("--max-active-runs", type=int, default=0)
    parser.add_argument("--max-stale-active-runs", type=int, default=0)
    parser.add_argument("--max-orphan-active-markers", type=int, default=0)
    parser.add_argument("--max-old-orphan-active-markers", type=int)
    parser.add_argument("--stale-run-age-seconds", type=int)
    parser.add_argument("--stale-marker-age-seconds", type=int, default=60)
    parser.add_argument("--marker-window-seconds", type=int, default=24 * 60 * 60)
    parser.add_argument("--sample-limit", type=int, default=5)
    parser.add_argument(
        "--settle-old-orphan-active-markers",
        action="store_true",
        help=(
            "Dry-run settling old persisted Pear active markers. Add --yes to edit "
            "messages through Zulip's normal update-message event path."
        ),
    )
    parser.add_argument("--settle-limit", type=int, default=20)
    parser.add_argument("--yes", action="store_true")
    parser.add_argument("--json", action="store_true")
    return parser.parse_args()


def maybe_reexec_with_checkout_venv() -> None:
    venv_dir = BASE_DIR / ".venv"
    venv_python = venv_dir / "bin" / "python3"
    if not venv_python.exists():
        return
    if Path(sys.prefix).resolve() == venv_dir.resolve():
        return
    env = os.environ.copy()
    env.pop("PYTHONHOME", None)
    env.pop("PYTHONPATH", None)
    env["VIRTUAL_ENV"] = str(venv_dir)
    env["PATH"] = f"{venv_dir / 'bin'}:{env.get('PATH', '')}"
    os.execve(str(venv_python), [str(venv_python), *sys.argv], env)


def main() -> int:
    args = parse_args()
    for name in (
        "max_active_runs",
        "max_stale_active_runs",
        "max_orphan_active_markers",
        "stale_marker_age_seconds",
        "marker_window_seconds",
        "sample_limit",
        "settle_limit",
    ):
        if getattr(args, name) < 0:
            raise SystemExit(f"--{name.replace('_', '-')} must be non-negative")
    if args.max_old_orphan_active_markers is not None and args.max_old_orphan_active_markers < 0:
        raise SystemExit("--max-old-orphan-active-markers must be non-negative")
    if args.stale_run_age_seconds is not None and args.stale_run_age_seconds <= 0:
        raise SystemExit("--stale-run-age-seconds must be positive")

    maybe_reexec_with_checkout_venv()

    settlements = []
    if args.settle_old_orphan_active_markers:
        settlements = settle_old_orphan_active_markers(
            marker_window_seconds=args.marker_window_seconds,
            limit=args.settle_limit,
            dry_run=not args.yes,
        )

    report = collect_health(
        stale_run_age_seconds=args.stale_run_age_seconds,
        stale_marker_age_seconds=args.stale_marker_age_seconds,
        marker_window_seconds=args.marker_window_seconds,
        sample_limit=args.sample_limit,
    )
    if args.json:
        payload = report_to_json(report)
        if args.settle_old_orphan_active_markers:
            payload["settlements"] = [
                {
                    "message_id": settlement.message_id,
                    "sender_id": settlement.sender_id,
                    "topic": settlement.topic,
                    "old_content": settlement.old_content,
                    "new_content": settlement.new_content,
                    "dry_run": settlement.dry_run,
                    "error": settlement.error,
                }
                for settlement in settlements
            ]
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        if args.settle_old_orphan_active_markers:
            print(render_settlement_results(settlements))
        print(render_report(report))

    if any(settlement.error for settlement in settlements):
        return 1

    violations = health_violations(
        report,
        max_active_runs=args.max_active_runs,
        max_stale_active_runs=args.max_stale_active_runs,
        max_orphan_active_markers=args.max_orphan_active_markers,
        max_old_orphan_active_markers=args.max_old_orphan_active_markers,
    )
    if violations:
        print("Pear health check failed:", file=sys.stderr)
        for violation in violations:
            print(f"- {violation}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
