{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:armada:contract:plugin-manifest-v1",
  "title": "Armada plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "description",
    "glyph",
    "requires",
    "provides"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}(?:-[0-9A-Za-z.-]{1,16})?$"
    },
    "author": {
      "type": "string",
      "maxLength": 60
    },
    "license": {
      "type": "string",
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "glyph": {
      "$ref": "#/$defs/glyph"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "armada"
      ],
      "properties": {
        "armada": {
          "type": "string",
          "pattern": "^>=[1-9][0-9]{0,2}$"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "setup": {
          "$ref": "#/$defs/argv"
        },
        "command": {
          "$ref": "#/$defs/argv"
        }
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~/-]*)?$"
        }
      }
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "secrets": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/secret"
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "widgets": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/widget"
          }
        },
        "links": {
          "type": "object",
          "maxProperties": 4,
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/link"
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9._~/-]{0,100}$"
            },
            "instructions": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "events": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "enum": [
              "message",
              "update_message",
              "delete_message",
              "reaction",
              "agent_run",
              "armada_plugin"
            ]
          }
        },
        "posts": {
          "type": "boolean"
        }
      }
    },
    "reaches": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^(?:\\*\\.)?[A-Za-z0-9-]{1,63}(?:\\.[A-Za-z0-9-]{1,63})+$"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "glyph": {
      "type": "string",
      "enum": [
        "search",
        "home",
        "repo",
        "repo-open",
        "hash",
        "lock",
        "plus",
        "nav",
        "branch",
        "commit",
        "pr",
        "more",
        "panel",
        "clip",
        "send",
        "steer",
        "answer",
        "queue",
        "stop",
        "down",
        "react",
        "thread",
        "copy",
        "link",
        "edit",
        "retry",
        "open",
        "latest",
        "folder",
        "folder-open",
        "file",
        "doc",
        "image",
        "table",
        "chart",
        "term",
        "diff",
        "minus",
        "check",
        "x",
        "expand",
        "right",
        "trace",
        "eye",
        "globe",
        "person",
        "settings",
        "sound",
        "mute",
        "gpu",
        "plugin"
      ]
    },
    "scalar": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "required": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "properties": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/setting"
          }
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "array"
          ]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "string",
                "integer",
                "number"
              ]
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "pattern": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "pattern": {
          "type": "string",
          "maxLength": 200
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "default": {
          "oneOf": [
            {
              "$ref": "#/$defs/scalar"
            },
            {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/scalar"
              }
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "env"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "required": {
          "type": "boolean"
        },
        "help": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "in"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "nav",
              "column",
              "open"
            ]
          }
        },
        "column_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "cadence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "team_default": {
          "type": "string",
          "enum": [
            "shown",
            "offered"
          ]
        },
        "options": {
          "$ref": "#/$defs/options"
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "figures": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "title",
              "figure",
              "sizer"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/key"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "figure": {
                "$ref": "#/$defs/binding"
              },
              "sizer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              }
            }
          }
        },
        "facets": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "title"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/key"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          }
        },
        "alerts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "title",
              "value",
              "op"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/key"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "value": {
                "$ref": "#/$defs/binding"
              },
              "op": {
                "type": "string",
                "enum": [
                  ">=",
                  "<="
                ]
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "binding": {
      "type": "string",
      "pattern": "^data\\.[A-Za-z0-9_-]{1,80}$"
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "to"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "to": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "channel",
              "topic"
            ]
          }
        },
        "pattern": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
