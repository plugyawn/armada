<div class="pear-canvas-pane">
    <div class="pear-canvas-header">
        <span class="pear-canvas-path">{{relative_path}}</span>
        {{! Populated by pear_topbar_tabs.ts: stale-version (CAS miss),
            oversize, and save-failure notices. }}
        <span class="pear-canvas-stale-notice notdisplayed"></span>
        <div class="pear-canvas-actions">
            <button type="button" class="pear-canvas-edit-button">{{t "Edit" }}</button>
            <button type="button" class="pear-canvas-save-button notdisplayed">{{t "Save" }}</button>
            <button type="button" class="pear-canvas-cancel-button notdisplayed">{{t "Cancel" }}</button>
        </div>
    </div>
    <div class="pear-canvas-rendered rendered_markdown"></div>
    <textarea class="pear-canvas-editor notdisplayed" aria-label="{{t 'Canvas source' }}"></textarea>
</div>
