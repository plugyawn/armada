<div class="legacy-wall-header">
    <input
      class="legacy-wall-input"
      type="text"
      autocomplete="off"
      maxlength="500"
      placeholder="{{t 'watch something…'}}"
      aria-label="{{t 'Create a wall monitor'}}"
      />
</div>
{{#if has_blocks}}
    <div class="legacy-wall-blocks">
        {{#each blocks}}
            <section
              class="legacy-wall-block legacy-wall-status-{{status}}
              {{collapsed_class}}"
              data-monitor-id="{{id}}"
              >
                <header class="legacy-wall-block-header">
                    <button
                      type="button"
                      class="legacy-wall-collapse"
                      data-wall-action="collapse"
                      aria-expanded="{{aria_expanded}}"
                      >{{collapse_glyph}}</button>
                    <span
                      class="legacy-wall-title"
                      title="{{ask}}"
                      >{{title}}</span>
                    <span class="legacy-wall-dot" aria-hidden="true"></span>
                </header>
                {{#unless collapsed}}
                    <div class="legacy-wall-body">
                        {{#if is_provisioning}}
                            <div class="legacy-wall-provisioning">
                                <span class="legacy-thinking-glyph-animated"></span>
                                <span>{{t "setting up…"}}</span>
                            </div>
                        {{else if is_error}}
                            <div class="legacy-wall-error">
                                <span
                                  class="legacy-wall-error-text"
                                  title="{{last_error}}"
                                  >{{last_error_short}}</span>
                                <button
                                  type="button"
                                  class="legacy-wall-foot-action"
                                  data-wall-action="rebuild"
                                  >⟳ {{t "rebuild"}}</button>
                            </div>
                        {{else}}
                            <div class="legacy-artifact-wall-host" data-legacy-artifact-host></div>
                        {{/if}}
                    </div>
                    <footer class="legacy-wall-block-footer">
                        {{#if show_cadence}}
                            <button
                              type="button"
                              class="legacy-wall-foot-action"
                              data-wall-action="cadence"
                              data-tippy-content="{{t 'Change cadence'}}"
                              >{{t "every"}} {{cadence_label}}</button>
                        {{/if}}
                        {{#if is_live}}
                            <button
                              type="button"
                              class="legacy-wall-foot-action"
                              data-wall-action="refresh"
                              data-tippy-content="{{t 'Refresh now'}}"
                              >⟳</button>
                            <button
                              type="button"
                              class="legacy-wall-foot-action"
                              data-wall-action="pause"
                              data-tippy-content="{{t 'Pause'}}"
                              >⏸</button>
                        {{/if}}
                        {{#if is_paused}}
                            <button
                              type="button"
                              class="legacy-wall-foot-action"
                              data-wall-action="resume"
                              data-tippy-content="{{t 'Resume'}}"
                              >▶</button>
                        {{/if}}
                        <span class="legacy-wall-foot-spacer"></span>
                        <button
                          type="button"
                          class="legacy-wall-foot-action legacy-wall-delete"
                          data-wall-action="delete"
                          data-tippy-content="{{t 'Remove'}}"
                          >✕</button>
                    </footer>
                {{/unless}}
            </section>
        {{/each}}
    </div>
{{else}}
    <div class="legacy-wall-empty">{{t "type above — armada keeps it live here"}}</div>
{{/if}}
